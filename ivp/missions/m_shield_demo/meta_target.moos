//-------------------------------------------------
// Target Vessel MOOS config file
// m_shield_demo — simulated intruder ("target")
//
// Port layout:
//   MOOSDB    : $(MOOS_PORT)   [default 9003]
//   pShare in : $(PSHARE_PORT) [default 9203]

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plugs.moos <origin_warp>

//----------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 50

  Run = MOOSDB         @ NewConsole = false
  Run = pRealm         @ NewConsole = false
  Run = uProcessWatch  @ NewConsole = false
  Run = pShare         @ NewConsole = false
  Run = pLogger        @ NewConsole = false
  Run = pNodeReporter  @ NewConsole = false
  Run = pMarinePIDV22  @ NewConsole = false
  Run = pHelmIvP       @ NewConsole = false
  Run = pHostInfo      @ NewConsole = false
  Run = uFldNodeBroker @ NewConsole = false
  Run = uSimMarineV22  @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = pTargetPathPlanner @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false ~uTimerScript_ZigCycle
}

#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//------------------------------------------------------
// uSimMarineV22 Config Block

ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10

  start_pos = $(START_POS), 0
  prefix    = NAV

  max_speed     = $(MAX_SPD)
  turn_rate     = 70
  turn_spd_loss = 0.6
}

//----------------------------------------------------
// pHelmIvP Config Block

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors = targ_$(VNAME).bhv
  verbose   = false
  domain    = course:0:359:360
  domain    = speed:0:$(MAX_SPD):21
}

//----------------------------------------------------
// pNodeReporter Config Block

ProcessConfig = pNodeReporter
{
  AppTick   = 2
  CommsTick = 2

  platform_color = $(COLOR)
  vessel_type    = ship

  coord_policy_global = true
}

//--------------------------------------------------------
// pContactMgrV20 Config Block
// Detects the approaching USVs and spawns a BHV_AvoidCollision
// against each, which is what lets them herd this vessel.

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 30,60

  alert_verbose = true

  contact_local_coords = force_lat_lon
  contact_max_age   = 35
  display_radii     = false

  // cpa_range must be >= alert_range: CMAlert::setAlertRangeFar()
  // clamps alert_range down to it otherwise. "alert_range=60,
  // cpa_range=25" therefore meant the target's avoidance was not
  // spawned until 25 m, not the 60 m the behavior below is tuned for.
  alert = id=target_avd_, var=TGT_CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=target_avd_, alert_range=60, cpa_range=75

  // One alert per templated behavior in targ_$(VNAME).bhv, each with a
  // DISTINCT name= prefix. A templated behavior spawns whenever its
  // update variable arrives -- conditions are not consulted at spawn
  // time -- and the instance is named from this "name=" field. Point
  // two templates at one alert and both instances want the same name;
  // the second is dropped, and the profile that owns it silently never
  // runs. Hence three alerts for three templates.
  //
  // The COLREGS profile is matched to target_avd_'s ranges so the two
  // avoidance models are compared on the same geometry.
  alert = id=target_col_, var=TGT_COLREGS_INFO, val="name=col_$[VNAME] # contact=$[VNAME]"
  alert = id=target_col_, alert_range=60, cpa_range=75

  // The harasser needs to acquire its quarry well before avoidance
  // range, otherwise it only starts the chase once the USV is already
  // being pushed away: spawn range matches BHV_CutRange's
  // pwt_outer_dist (90 m), with cpa_range above it as the contact
  // manager clamps alert_range down to cpa_range otherwise.
  alert = id=target_cut_, var=TGT_HARASS_INFO, val="name=cut_$[VNAME] # contact=$[VNAME]"
  alert = id=target_cut_, alert_range=90, cpa_range=110

  post_closest_range   = true
  hold_alerts_for_helm = true
}

//--------------------------------------------------
// uFldNodeBroker Config Block

ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_SEGLIST
  bridge = src=VIEW_POINT
  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
}

//-----------------------------------------------------
// pMarinePIDV22 Config Block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 10
  CommsTick  = 10

  verbose       = true
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder    = 100
  maxthrust    = 100
  speed_factor = 20
}

//--------------------------------------------------
// pTargetPathPlanner Config Block
//
// The operator's route for this vessel. Pick "target_path" in the
// pMarineViewer mouse-context menu and left-click the waypoints in
// order; the clicks arrive here as TARGET_PATH_VERTEX (pShare'd down
// from the shoreside) and go straight into the patrol behavior.
//
// It lives in this community rather than on the shoreside so the route
// update is a local post to the helm -- no relay, and no chance of the
// pShare input/output collision that bit the mothership's tasking.

ProcessConfig = pTargetPathPlanner
{
  AppTick   = 2
  CommsTick = 2

  update_var  = TGT_WPT_UPDATE
  route_label = target_route

  // Apply as soon as there are two points, so the route takes effect
  // while it is being drawn rather than only on the APPLY button.
  auto_apply  = true
  close_loop  = true

  // The launch script's built-in patrol: what the vessel flies until
  // the operator draws something else.
  default_route = $(TGT_PATROL)
}

//--------------------------------------------------
// uTimerScript_ZigCycle Config Block
//
// Re-sync pulse for the "zigzag" target profile.
//
// BHV_ZigZag latches its stem heading once, on the idle->run
// transition, and never re-reads it. On a patrol loop that heading is
// stale the moment the vessel rounds a corner, and from then on the
// behavior is zigging about a bearing the route has left behind. This
// script drops TGT_ZIG false for a few seconds every cycle, which takes
// the behavior to idle and back, and the re-entry re-latches the stem
// to the current heading.
//
// The gap has to be long enough to be worth something, not just long
// enough to force the transition: BHV_ZigZag outweighs the patrol while
// it is running (see its pwt), so this window is the only stretch in
// which the route behavior actually has the helm to itself and can pull
// the vessel back onto its line. One second of it would re-latch the
// stem to a heading the S-turns had already displaced, and the route
// would be given up a little further on every cycle.
//
// Free-running rather than gated on the profile: it costs two postings
// a cycle, and BHV_ZigZag is the only subscriber to TGT_ZIG, so it has
// no effect at all under any other profile.
ProcessConfig = uTimerScript_ZigCycle
{
  AppTick   = 4
  CommsTick = 4

  reset_max  = unlimited
  reset_time = $(TGT_ZIG_PERIOD=40)

  event = var=TGT_ZIG, val=false, time=0
  event = var=TGT_ZIG, val=true,  time=$(TGT_ZIG_GAP=15)
}

//--------------------------------------------------
// pLogger Config Block

ProcessConfig = pLogger
{
  AppTick   = 5
  CommsTick = 5

  File          = LOG_%(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = APPCAST
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = *ITER_GAP, *ITER_LEN
}
