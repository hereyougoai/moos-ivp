//-------------------------------------------------
// Vehicle Helm config file (USV)
// m_shield_demo — Sub-vessel behavior

initialize  DEPLOY        = false
initialize  RETURN        = false
initialize  STATION_KEEP  = false
initialize  BLOCK_ACTIVE  = false
initialize  LOITER        = true    // Default: loiter at assigned position
initialize  AVOID         = true
initialize  TARGET_ALERT  = false
initialize  SURVEY        = false

// Raised by pLandGuard when a vehicle has stopped making way and is not
// holding station on purpose. See the unstick behavior at the end of file.
initialize  STUCK = false

//----------------------------------------------
// Mode Hierarchy
// Priority (top wins): STATION-KEEPING > RETURNING > INTERCEPTING > SURVEYING > LOITERING
//----------------------------------------------

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
}

set MODE = INTERCEPTING {
  MODE = ACTIVE
  TARGET_ALERT = true
  RETURN = false
}

set MODE = SURVEYING {
  MODE = ACTIVE
  SURVEY = true
  RETURN = false
  STATION_KEEP = false
  TARGET_ALERT = false
}

// The fallback, deliberately without a LOITER = true clause.
//
// Every other sub-mode needs a flag set. If the coordinator or the operator
// leaves all of them false, MODE resolves to ACTIVE with no sub-mode, no
// behavior runs, and the helm reports an all-stop with reason NothingToDo --
// the vehicle stops dead and stays stopped, with nothing on screen to say
// why. Making LOITERING the else-case of ACTIVE means a deployed vehicle
// with no assignment loiters instead of halting.
//
// LOITER is still honoured as a positive request; it is simply no longer
// required to reach this mode.
set MODE = LOITERING {
  MODE = ACTIVE
  SURVEY = false
  TARGET_ALERT = false
  RETURN = false
  STATION_KEEP = false
}

//----------------------------------------------
// BHV_StationKeep — Hold position at current point
Behavior = BHV_StationKeep
{
  name      = station_keep
  pwt       = 100
  condition = MODE == STATION-KEEPING
  // Hold wherever the vehicle was when the mode engaged. A fixed
  // station_pt sent both USVs charging across the field to 0,0 the
  // moment the link watchdog or the STATION button fired.
  center_activate = true
  inner_radius = 5
  outer_radius = 20
  outer_speed  = 1.2
}

//----------------------------------------------
// BHV_Loiter — Circle at assigned loiter position (default idle behavior)
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE == LOITERING
  updates   = UP_LOITER

  speed    = $(STOCK_SPD)
  radius   = 8.0
  nm_radius = 15.0
  // Center is set dynamically via UP_LOITER=center_assign=X,Y from shoreside
  polygon  = radial:: $(LOITER_POS), radius=30, pts=8, snap=1, label=$(VNAME)_loiter
  clockwise = false
}

//----------------------------------------------
// BHV_Waypoint — Survey: lawnmower search pattern
// WPT_UPDATE is fed by pRegionDivider (via Mothership → Shoreside → Vehicle)
Behavior = BHV_Waypoint
{
  name      = survey_region
  pwt       = 100
  condition = MODE == SURVEYING
  updates   = WPT_UPDATE
  perpetual = true

  speed          = $(STOCK_SPD)
  capture_radius = 5.0
  slip_radius    = 15.0

  // Fallback pattern so the behavior is never empty in the seconds
  // between helm start-up and the mothership's assignment arriving.
  // Overwritten by the first WPT_UPDATE from pRegionDivider.
  //
  // Drawn invisible, permanently, on purpose -- two reasons:
  //  1) The placeholder itself has nothing to do with the operator's
  //     drawn region, so flashing it on the chart before the real
  //     assignment lands looks like a stray, misplaced polygon.
  //  2) BHV_Waypoint erases its own segment list the instant this
  //     behavior stops running (e.g. the moment INTERCEPT engages),
  //     which would make the sweep pattern disappear from the chart
  //     every time the mode changed. pRegionDivider instead draws the
  //     lawnmower path itself as a persistent VIEW_SEGLIST (label
  //     <vname>_survey_path) that survives mode changes, so that copy
  //     is authoritative and this one stays off.
  visual_hints = edge_color=invisible, vertex_color=invisible, label_color=invisible
  points = format=lawnmower, label=$(VNAME)_survey, x=70, y=-50, height=80, width=160, lane_width=25, rows=east-west, startx=-70, starty=-10
}

//----------------------------------------------
// BHV_Trail — Intercept/shadow the suspect target
// TRAIL_UPDATE is fed by pTargetCoordinator (via Mothership → Shoreside → Vehicle)
Behavior = BHV_Trail
{
  name       = trail_target
  pwt        = 150
  condition  = MODE == INTERCEPTING
  // Mutually exclusive with block_station below. pTargetCoordinator
  // runs one or the other depending on its pincer_mode, and BLOCK_ACTIVE
  // is the switch. Two behaviors both trying to place the same vehicle
  // would just average into a station neither asked for.
  condition  = BLOCK_ACTIVE = false
  updates    = TRAIL_UPDATE

  contact     = target
  trail_range = 25      // Station distance; coordinator may override
  // pTargetCoordinator computes the blocking arc in absolute bearings --
  // it puts the USVs on the arc between the target and the middle of the
  // mission region, so the pair forms a wall that herds the target
  // outward rather than two boats queuing up in its wake -- but it hands
  // the station over as an offset from the TARGET'S HEADING.
  //
  // Why relative and not absolute: under an absolute order the whole
  // heading-dependent part of the geometry has to be re-sent over the
  // wire, quantised and a tick late, so the trail points stuttered
  // across the chart whenever the target turned. In relative mode this
  // behavior adds the heading term itself, every helm iteration, from
  // its own extrapolated contact record, so the station sweeps with the
  // turn. Both frames name the same point; only the update path differs.
  //
  // Until the first TRAIL_UPDATE arrives, 180 relative (dead astern of
  // the target) is a harmless start.
  trail_angle = 180
  trail_angle_type = relative

  // CANT ANGLE — how the USV's own BOW is held once it is ON STATION.
  //
  // On station this behavior steers ownship at the CONTACT'S OWN COURSE,
  // so with no cant the two USVs run exactly PARALLEL to the intruder,
  // alongside it. That parallel course is the zero of this number:
  // trail_cant turns the bow off it, and pTargetCoordinator signs it per
  // vehicle so that it always turns the bow IN toward the intruder's
  // centreline -- the pair stops running abreast and starts cutting in.
  //
  // It moves the bow only. The station stays trail_angle off the
  // intruder at trail_range and the speed is still matched, so the arc
  // keeps its shape and its standoff; only what each USV is pointing at
  // changes.
  //
  // 0 here is the stock geometry, and it is what stands until the
  // coordinator's first TRAIL_UPDATE arrives. The live value comes from
  // cant_deg in the pTargetCoordinator block (Action/Cant Angle on the
  // shoreside), in the same update as the station bearing.
  trail_cant = 0

  // Cornering: the trail point swings fast when the target turns, so
  // a tight capture radius makes the helm chase it and saw the rudder.
  // nm_radius gives a wide outer band where the helm heads for the
  // station without demanding an exact hit, which smooths the arc.
  radius      = 8
  nm_radius   = 25

  // pwt_outer_dist is NOT a priority ramp -- BHV_Trail's getRelevance()
  // returns a hard 0 outside it, so the behavior produced no objective
  // function at all and a USV further than 60m from the target simply
  // ignored INTERCEPT until something else happened to carry it closer.
  // Zero means "no cutoff": press INTERCEPT and it sets off immediately,
  // from anywhere in the field.
  pwt_outer_dist = 0
}

//----------------------------------------------
// BHV_StationKeep — the blocking station (the eviction mechanism)
//
// WHY THIS EXISTS, AND WHY BHV_Trail COULD NOT DO IT.
//
// The intruder is driven off by its OWN collision avoidance: we put a
// vessel where it does not want to go and let its avoidance behavior
// turn it. That behavior (BHV_AvoidCollision on the target) scores
// every candidate course and speed by PROJECTED CPA -- zero utility
// below 12 m, full utility above 25 m.
//
// The consequence is easy to miss: what matters is not how CLOSE our
// USV is, it is whether our USV lies on the water the intruder is about
// to occupy. And a projected CPA needs relative velocity to exist at
// all. BHV_Trail, once inside its capture radius, steers the vehicle at
// the contact's own course and speed -- so the pair moves as one, the
// relative velocity is zero, the projected CPA equals the present range
// for EVERY manoeuvre the intruder could make, and its avoidance
// function is flat. A flat function changes nothing in the helm's
// solution no matter how much weight it carries. Measured over the
// intruder's whole manoeuvre space, the best escape it could find beat
// holding course by 0.0 at every trail range from 30 m down to 14 m:
// the trail arc was an escort, not a wall, which is exactly what it
// looked like on the water.
//
// A GROUND-FIXED station does not move with the intruder, so it has a
// relative velocity, so it has a CPA, so it produces a gradient. At the
// coordinator's default geometry -- 50 m ahead of the intruder and 18 m
// off its track -- carrying on scores 59.6 against 100 for turning
// away, and it turns.
//
// SAFE DISTANCE. The 18 m lateral offset IS the distance the intruder
// passes at if it ignores us completely, so it is the safety number of
// this whole mode, and the coordinator floors it at 14 m. Three
// separate margins sit under it:
//   - 6 m above the 12 m CPA the intruder's own behavior treats as a
//     collision, so we are never staging one;
//   - 4 m above the 14 m min_util_cpa_dist of avdtgt_ below, the CPA
//     our own avoidance of the intruder calls the floor of a
//     safe pass;
//   - and the station is ~53 m from the intruder in straight-line
//     RANGE, well outside avdtgt_'s 22 m pwt_outer_dist, so holding the
//     block does not put the two behaviors in conflict at all.
// If the intruder closes anyway, avdtgt_ (pwt 300) outranks this
// behavior (pwt 200) and the USV gives way. The block is a position, not
// a refusal to keep clear.
//
// This is an interdiction manoeuvre, not a collision-avoidance one, and
// it is the one place in the mission where our vessels deliberately
// stand in front of another. It is stationing, not crossing: the USV is
// stopped on its point before the intruder arrives, and it yields if
// the intruder presses on.
Behavior = BHV_StationKeep
{
  name      = block_station
  pwt       = 200
  condition = MODE == INTERCEPTING
  condition = BLOCK_ACTIVE = true
  updates   = BLOCK_UPDATE

  // center_activate MUST be false: the point comes from the
  // coordinator, and "hold wherever you happen to be" is the one thing
  // a blocking station must not do.
  center_activate = false
  station_pt      = 0,0

  // Tight hold. Drifting 20 m off the point puts the intruder's CPA
  // back outside the range it reacts to and the block silently stops
  // working, so this is not the place for a lazy watch circle.
  inner_radius = 4
  outer_radius = 12
  outer_speed  = 1.5

  // Getting there matters as much as holding: the point is only useful
  // while the intruder is still short of it.
  transit_speed = 3.0
  swing_time    = 2
}

//----------------------------------------------
// Collision avoidance (always active)
//
// BHV_AvoidCollision scores every candidate course/speed on PROJECTED CPA
// DISTANCE ALONE (AOF_AvoidCollision). The metric has no term for which
// side the contact is on, no give-way/stand-on role and no preferred turn
// direction, so the manoeuvre it produces is side-agnostic: a head-on pair
// may resolve starboard-to-starboard as readily as port-to-port, and in a
// crossing BOTH vessels manoeuvre.
//
// That is a deliberate choice for this mission, not an oversight. The
// rule-based variant (BHV_AvdColregsV22) was used here for a time and has
// been taken back out: the USVs are an interdiction pair whose whole job is
// to stand between the intruder and the region, and a give-way/stand-on
// role assignment kept deciding which USV moved on encounter geometry
// rather than on where the barrier needed to be. What is kept is the part
// that matters for a safe run -- a real CPA floor, with ample-time spawn
// ranges -- so no hull is ever aimed at another.
//
// The distances below are what make that floor real; they are unchanged
// from the tuned values and should not be shrunk casually.

Behavior = BHV_AvoidCollision
{
  name       = avdcol_
  pwt        = 300
  condition  = AVOID = true
  condition  = MODE == ACTIVE
  updates    = CONTACT_INFO
  templating = spawn

  contact           = to-be-set
  on_no_contact_ok  = true
  extrapolate       = true
  decay             = 30,60

  use_refinery          = true
  can_disable           = true
  post_per_contact_info = true

  // Scaled to the field (280 x 120 m) and to a 4 m/s head-on closing
  // speed: 45 m is ~11 s of warning, which is what makes a single
  // substantial alteration possible instead of a succession of small
  // late ones.
  pwt_outer_dist    = 45
  pwt_inner_dist    = 20

  // completed_dist must sit WELL ABOVE the contact manager's
  // alert_range (60 m), not near it. A spawned behavior retires itself
  // at completed_dist*1.1; set that at or below the spawn range and the
  // behavior dies the moment it is created, while the contact manager --
  // which never saw the range cross back out -- does not re-alert. The
  // result is a contact that is permanently "complete" and never
  // avoided at all. That is exactly what happened to ben here: it sat
  // at mode=complete straight through a 17.5 m head-on pass.
  completed_dist    = 90

  // The CPA below which a solution is worthless, and the CPA at which
  // it is perfect. The old 5 m / 10 m pair was not a safe passing
  // distance for vessels of this size at these speeds.
  min_util_cpa_dist = 12
  max_util_cpa_dist = 20

  pwt_grade = linear
  bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}

//----------------------------------------------
// Collision avoidance of the designated intruder
//
// Same CPA metric as above, distances scaled to the interception.
// A separate instance is needed because the pincer deliberately holds
// station at trail_range (25 m) off the target: run that contact through
// the 45 m band above and the avoidance behavior would be permanently
// active against the very vessel BHV_Trail is trying to hold station on,
// and the two would fight each other.
//
// 22 m outer keeps it silent at the 30 m station and biting the moment
// the USV closes further; 14 m min_util_cpa_dist is the floor the
// interception may not breach. pwt 300 -- above the trail behavior's
// 150 -- so when it does bite, keeping clear outranks holding station.
//
// The margin between the station range and this outer distance is what
// decides whether the two behaviors cooperate or fight. At 40 m station
// against a 35 m outer distance there were only 5 m of it: any
// overshoot chasing a manoeuvring intruder put the USV inside the
// avoidance band, where pwt 300 beats the trail behavior's 150 and the
// USV was pushed back off the station it had been sent to. It never
// settled, and the wall it was supposed to form never formed. 30 vs 22
// gives 8 m of margin at a station range where the intruder's own
// avoidance is at full strength.
Behavior = BHV_AvoidCollision
{
  name       = avdtgt_
  pwt        = 300
  condition  = AVOID = true
  condition  = MODE == ACTIVE
  updates    = TGT_AVD_INFO
  templating = spawn

  contact           = to-be-set
  on_no_contact_ok  = true
  extrapolate       = true
  decay             = 30,60

  use_refinery          = true
  can_disable           = true
  post_per_contact_info = true

  pwt_outer_dist    = 22
  pwt_inner_dist    = 14
  completed_dist    = 60   // > alert_range (32), see the note above

  // min_util_cpa_dist is where the utility of a solution reaches zero,
  // not a hard constraint -- the helm maximises over ALL behaviors, so
  // a strong pull from BHV_Trail can still buy a closer pass.
  min_util_cpa_dist = 14
  max_util_cpa_dist = 20

  pwt_grade = linear
  bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}

//----------------------------------------------
// BHV_Waypoint — Return to home position
Behavior = BHV_Waypoint
{
  name        = waypt_return
  pwt         = 100
  updates     = RETURN_UPDATES
  condition   = MODE == RETURNING
  // Without perpetual the behavior is retired after the first RETURN,
  // so a second RETURN left the helm in RETURNING mode with nothing
  // running at all. Keep it alive so the mission can be re-run.
  perpetual   = true
  endflag     = STATION_KEEP = true
  endflag     = AVOID = false

  speed     = 1.3
  radius    = 3.0
  nm_radius = 15.0

  // Mid-lake, not the old 0,0. That point is 20 m off the shoreline, so a
  // vehicle sent home would station-keep inside pLandGuard's throttle band
  // and with the land avoidance permanently nudging it. 90,-80 has 113 m of
  // water around it.
  points    = 90,-80
  lead      = 8
}

//----------------------------------------------
// BHV_AvoidObstacleV24 — Charted land
//
// One instance spawns per land tile that pObstacleMgr reports within its
// alert_range; the tiles themselves come from gen_land.py and are the convex
// decomposition of the real Forrest Lake shoreline.
//
// pwt is above avdcol_ (300) and well above the waypoint and trail behaviors.
// That ordering is deliberate: giving way to another hull is negotiable,
// running aground is not.
//
// Two failure modes end in an all-stop rather than a bad turn. If ownship is
// already inside a tile no IvP function can be built, and if the turn radius
// makes contact unavoidable every heading scores zero utility; either posts
// an error, which the helm turns into DESIRED_SPEED = 0. Both are backstops,
// not the intended path -- and note that uSimMarine has no collision model at
// all, so nothing but this behavior keeps a hull off the beach.
//
// $(LAND_ALLSTOP) is set false by the benchmark scripts: one grazed headland
// would otherwise zero the speed and poison the statistics for a whole run.
Behavior = BHV_AvoidObstacleV24
{
  name       = avd_land_
  pwt        = 500
  condition  = AVOID = true
  condition  = MODE == ACTIVE
  updates    = OBSTACLE_ALERT
  templating = spawn

  // Warn, do not halt -- on both counts. A halt here is a deadlock, not a
  // safety measure: the vehicle is told to stop, and the condition that
  // stopped it only clears by moving. Recovery is pLandGuard's job now
  // (LAND_BREACH below), and recovery needs a vehicle it can still steer.
  //
  // allstop_on_unavoidable is a local addition to BHV_AvoidObstacleV24. The
  // stock behavior halts unconditionally when every course and speed scores
  // zero utility; that case is "still outside, but out of room to turn",
  // which is exactly when recovery should be driving, not stopping.
  //
  // Set both true to get the stock grounding behavior back.
  allstop_on_breach      = $(LAND_ALLSTOP=false)
  allstop_on_unavoidable = $(LAND_ALLSTOP=false)

  // 30 m is roughly 8 s of warning at a 4 m/s pursuit speed, which leaves
  // room for one smooth alteration instead of a late, hard one.
  pwt_outer_dist = 30
  pwt_inner_dist = 12

  // Must exceed pObstacleMgr's alert_range (35), or a spawned instance
  // retires itself while the manager is still alerting on the same tile and
  // the pair thrash against each other.
  completed_dist = 40

  // The platform model is not configured for this behavior, so it solves
  // holonomically whatever this says. Without the flag every instance posts a
  // warning about that on every iteration -- 8,659 of them in one run, which
  // buries the warnings that mean something.
  holonomic_ok   = true

  // The standoff. Not buffer_dist -- that belonged to the pre-V24 behavior,
  // and V24 rejects it outright, which takes the whole helm to MALCONFIG
  // rather than just ignoring the line. V24 states the same thing as the CPA
  // band: minimum utility at 8 m from the tile, full utility by 18 m.
  //
  // The tiles were already grown 4 m seaward of the true waterline when they
  // were generated, so 8 m here puts a hull about 12 m off the real shore.
  min_util_cpa_dist = 8
  max_util_cpa_dist = 18
  allowable_ttc     = 6
}

//----------------------------------------------
// Land guard: throttle, and recovery
//
// Two layers on top of BHV_AvoidObstacleV24, both driven by pLandGuard.
//
// The avoidance behavior handles the ordinary approach. What it cannot do is
// act once the vehicle is inside an obstacle -- its objective function
// answers "which way is least likely to hit this", which has no answer after
// the fact, so it falls silent and the survey waypoints take over, steering
// by a plan that knows nothing about land.

//----------------------------------------------
// BHV_ConstantSpeed - throttle back near the shore
//
// Not merely for reaction time. Running out of turning room IS the
// "unavoidable" case in BHV_AvoidObstacleV24, and turning room is bought
// with speed: at $(LAND_SLOW_SPD=0.8) m/s the geometry that produces it is
// hard to reach in the first place.
//
// pwt sits below the avoidance behaviors, which decide the heading. This one
// only argues about speed, and losing that argument is harmless.
Behavior = BHV_ConstantSpeed
{
  name       = land_slow
  pwt        = 200
  condition  = MODE == ACTIVE
  condition  = LAND_SLOW = true
  duration   = no-time-limit
  perpetual  = true

  speed      = $(LAND_SLOW_SPD=0.8)
  basewidth  = 0.3
  peakwidth  = 0.1
}

//----------------------------------------------
// BHV_Waypoint - drive back off the beach
//
// Destination comes from pLandGuard as the last position at which this
// vehicle had real open water around it -- not the nearest water, which can
// lie across a spit and be reachable only by crossing more land. The vehicle
// arrived from that point, so it can return to it: for recovery,
// reachability beats distance.
//
// pwt above the land avoidance (500) on purpose. While recovering, the two
// would otherwise argue: avoidance wants distance from the tile, this wants
// a specific heading out. In practice they rarely conflict, since driving
// away puts the obstacle astern and isObstacleAft() quiets avoidance anyway.
//
// The escape point is published continuously, not just at breach time, so
// this behavior always has a live destination loaded before the condition
// flips. UPDATES are consumed whether a behavior is running or idle.
Behavior = BHV_Waypoint
{
  name       = land_escape
  pwt        = 600
  condition  = MODE == ACTIVE
  condition  = LAND_BREACH = true
  updates    = LAND_ESCAPE_UPDATE
  perpetual  = true

  speed          = $(LAND_ESCAPE_SPD=1.2)
  capture_radius = 6.0
  slip_radius    = 12.0
  lead           = 8

  visual_hints = nextpt_color=red, vertex_color=red
  visual_hints = edge_color=red, edge_size=2
}

//----------------------------------------------
// BHV_ConstantSpeed - break a mutual-avoidance deadlock
//
// Two hulls whose collision avoidance both solve to "hold still" are a
// stable fixed point: neither moves, so the geometry never changes, so
// neither ever moves again. Nothing reports it -- the helm is solving
// happily and the answer it keeps reaching is zero. Observed with all three
// vessels frozen for the remaining 8000 s of a run after one closed to 4.8 m
// of the intruder while trailing.
//
// pLandGuard raises STUCK after $(STUCK_SECS=20)s with no way on. This puts
// a floor under the solved speed; it does NOT touch heading, which still
// comes from the avoidance behaviors, so the vehicle leaves along the
// least-bad course rather than being steered blind into whatever it was
// avoiding. Any motion at all is enough -- once the geometry changes the
// fixed point is gone and the flag drops on the next iteration.
//
// pwt above the avoidance behaviors on purpose, and only on speed: this is
// the one argument they must not win, because their answer is what has the
// vehicle stopped.
Behavior = BHV_ConstantSpeed
{
  name       = unstick
  pwt        = 700
  condition  = MODE == ACTIVE
  condition  = STUCK = true
  duration   = no-time-limit
  perpetual  = true

  speed      = $(UNSTICK_SPD=0.9)
  basewidth  = 0.4
  peakwidth  = 0.1
}
