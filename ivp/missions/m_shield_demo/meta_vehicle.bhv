//-------------------------------------------------
// Vehicle Helm config file (USV)
// m_shield_demo — Sub-vessel behavior

initialize  DEPLOY        = false
initialize  RETURN        = false
initialize  STATION_KEEP  = false
initialize  LOITER        = true    // Default: loiter at assigned position
initialize  AVOID         = true
initialize  TARGET_ALERT  = false
initialize  SURVEY        = false

//----------------------------------------------
// Mode Hierarchy
// Priority (top wins): STATION-KEEPING > RETURNING > INTERCEPTING > SURVEYING > LOITERING
//----------------------------------------------

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
}

set MODE = RETURNING {
  MODE = ACTIVE
  RETURN = true
}

set MODE = INTERCEPTING {
  MODE = ACTIVE
  TARGET_ALERT = true
  RETURN = false
}

set MODE = SURVEYING {
  MODE = ACTIVE
  SURVEY = true
  RETURN = false
  STATION_KEEP = false
  TARGET_ALERT = false
}

set MODE = LOITERING {
  MODE = ACTIVE
  LOITER = true
  SURVEY = false
  TARGET_ALERT = false
  RETURN = false
  STATION_KEEP = false
}

//----------------------------------------------
// BHV_StationKeep — Hold position at current point
Behavior = BHV_StationKeep
{
  name      = station_keep
  pwt       = 100
  condition = MODE == STATION-KEEPING
  // Hold wherever the vehicle was when the mode engaged. A fixed
  // station_pt sent both USVs charging across the field to 0,0 the
  // moment the link watchdog or the STATION button fired.
  center_activate = true
  inner_radius = 5
  outer_radius = 20
  outer_speed  = 1.2
}

//----------------------------------------------
// BHV_Loiter — Circle at assigned loiter position (default idle behavior)
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE == LOITERING
  updates   = UP_LOITER

  speed    = $(STOCK_SPD)
  radius   = 8.0
  nm_radius = 15.0
  // Center is set dynamically via UP_LOITER=center_assign=X,Y from shoreside
  polygon  = radial:: $(LOITER_POS), radius=30, pts=8, snap=1, label=$(VNAME)_loiter
  clockwise = false
}

//----------------------------------------------
// BHV_Waypoint — Survey: lawnmower search pattern
// WPT_UPDATE is fed by pRegionDivider (via Mothership → Shoreside → Vehicle)
Behavior = BHV_Waypoint
{
  name      = survey_region
  pwt       = 100
  condition = MODE == SURVEYING
  updates   = WPT_UPDATE
  perpetual = true

  speed          = $(STOCK_SPD)
  capture_radius = 5.0
  slip_radius    = 15.0

  // Fallback pattern so the behavior is never empty in the seconds
  // between helm start-up and the mothership's assignment arriving.
  // Overwritten by the first WPT_UPDATE from pRegionDivider.
  //
  // Drawn invisible, permanently, on purpose -- two reasons:
  //  1) The placeholder itself has nothing to do with the operator's
  //     drawn region, so flashing it on the chart before the real
  //     assignment lands looks like a stray, misplaced polygon.
  //  2) BHV_Waypoint erases its own segment list the instant this
  //     behavior stops running (e.g. the moment INTERCEPT engages),
  //     which would make the sweep pattern disappear from the chart
  //     every time the mode changed. pRegionDivider instead draws the
  //     lawnmower path itself as a persistent VIEW_SEGLIST (label
  //     <vname>_survey_path) that survives mode changes, so that copy
  //     is authoritative and this one stays off.
  visual_hints = edge_color=invisible, vertex_color=invisible, label_color=invisible
  points = format=lawnmower, label=$(VNAME)_survey, x=70, y=-50, height=80, width=160, lane_width=25, rows=east-west, startx=-70, starty=-10
}

//----------------------------------------------
// BHV_Trail — Intercept/shadow the suspect target
// TRAIL_UPDATE is fed by pTargetCoordinator (via Mothership → Shoreside → Vehicle)
Behavior = BHV_Trail
{
  name       = trail_target
  pwt        = 150
  condition  = MODE == INTERCEPTING
  updates    = TRAIL_UPDATE

  contact     = target
  trail_range = 25      // Station distance; coordinator may override
  // pTargetCoordinator posts ABSOLUTE bearings: it puts the USVs on the
  // arc between the target and the middle of the mission region, so the
  // pair forms a wall that herds the target outward rather than two
  // boats queuing up in its wake. Until the first TRAIL_UPDATE arrives,
  // 180 absolute (station due south of the target) is a harmless start.
  trail_angle = 180
  trail_angle_type = absolute

  // Cornering: the trail point swings fast when the target turns, so
  // a tight capture radius makes the helm chase it and saw the rudder.
  // nm_radius gives a wide outer band where the helm heads for the
  // station without demanding an exact hit, which smooths the arc.
  radius      = 8
  nm_radius   = 25

  // pwt_outer_dist is NOT a priority ramp -- BHV_Trail's getRelevance()
  // returns a hard 0 outside it, so the behavior produced no objective
  // function at all and a USV further than 60m from the target simply
  // ignored INTERCEPT until something else happened to carry it closer.
  // Zero means "no cutoff": press INTERCEPT and it sets off immediately,
  // from anywhere in the field.
  pwt_outer_dist = 0
}

//----------------------------------------------
// BHV_AvoidCollision — Spawning collision avoidance (always active)
Behavior = BHV_AvoidCollision
{
  name       = avdcol_
  pwt        = 300
  condition  = AVOID = true
  condition  = MODE == ACTIVE
  updates    = CONTACT_INFO
  templating = spawn

  contact           = to-be-set
  on_no_contact_ok  = true
  extrapolate       = true
  decay             = 30,60

  // Kept tighter than the 25m pincer station: at the old 30m outer
  // distance the avoidance behavior was permanently active against the
  // very contact the trail behavior was trying to close on, and the two
  // fought each other instead of holding station.
  pwt_outer_dist    = 20
  pwt_inner_dist    = 10
  completed_dist    = 30
  min_util_cpa_dist = 5
  max_util_cpa_dist = 10
  pwt_grade         = linear
  bearing_line_config = white:0, green:0.65, yellow:0.8, red:1.0
}

//----------------------------------------------
// BHV_Waypoint — Return to home position
Behavior = BHV_Waypoint
{
  name        = waypt_return
  pwt         = 100
  updates     = RETURN_UPDATES
  condition   = MODE == RETURNING
  // Without perpetual the behavior is retired after the first RETURN,
  // so a second RETURN left the helm in RETURNING mode with nothing
  // running at all. Keep it alive so the mission can be re-run.
  perpetual   = true
  endflag     = STATION_KEEP = true
  endflag     = AVOID = false

  speed     = 1.3
  radius    = 3.0
  nm_radius = 15.0
  points    = 0,0
  lead      = 8
}
