//--------------------------------------------------------
// Shoreside Config file
// M. Benjamin, MIT	

ServerHost = localhost
ServerPort = 9000
Community  = shoreside

#include plugs.moos <origin_warp>
  
//--------------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = uTimerScript    @ NewConsole = false ~ uTimerScript_Heartbeat
	Run = pMarineViewer   @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false
  Run = uFldShoreBroker @ NewConsole = false
  Run = uFldNodeComms   @ NewConsole = false
}

#include plugs.moos <pHostInfo>
//--------------------------------------------------
// pShare Config Block (shoreside)
// Inbound: everything vehicles and the mothership send us.
// Outbound: the fleet picture and the operator's mission region,
//           pushed up to the mothership coordinator.
// (uFldShoreBroker adds the shore->vehicle routes dynamically.)

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2

  input = route = localhost:$(PSHARE_PORT)

  // Uplink to the mothership coordinator.
  // NOTE: never add an output route for a variable that also arrives
  //       on the input route (e.g. NODE_REPORT) — pShare then refuses
  //       to inject the incoming copy into the local DB. Vehicles send
  //       their NODE_REPORTs to the mothership directly instead.
  output = src_name=MISSION_POLY,      route=localhost:$(MSHIP_PSHARE=9205)
  output = src_name=REGION_VERTEX,     route=localhost:$(MSHIP_PSHARE=9205)
  output = src_name=REGION_CLEAR,      route=localhost:$(MSHIP_PSHARE=9205)
  output = src_name=DEPLOY_ALL,        route=localhost:$(MSHIP_PSHARE=9205)
  output = src_name=TARGET_ALERT_ALL,  route=localhost:$(MSHIP_PSHARE=9205)

  // Search-plan controls: which pattern to lay into each band, and how
  // far the sensor sees (which sets the lane spacing and how far the
  // lane ends can be trimmed).
  output = src_name=SEARCH_PATTERN,    route=localhost:$(MSHIP_PSHARE=9205)
  output = src_name=SENSOR_RADIUS,     route=localhost:$(MSHIP_PSHARE=9205)

  // Operator-drawn route for the intruder, straight down to the target
  // community where pTargetPathPlanner turns it into a TGT_WPT_UPDATE.
  output = src_name=TARGET_PATH_VERTEX, route=localhost:$(TARGET_PSHARE=9203)
  output = src_name=TARGET_PATH_CLEAR,  route=localhost:$(TARGET_PSHARE=9203)
  output = src_name=TARGET_PATH_UNDO,   route=localhost:$(TARGET_PSHARE=9203)
  output = src_name=TARGET_PATH_APPLY,  route=localhost:$(TARGET_PSHARE=9203)
  output = src_name=TARGET_PATH_ROUTE,  route=localhost:$(TARGET_PSHARE=9203)
}

#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// uFldShoreBroker Config Block

ProcessConfig = uFldShoreBroker
{ 
  AppTick       = 1
  CommsTick     = 1

  // Note: [QBRIDGE = FOO]  is shorthand for                    
  //       [BRIDGE = src=FOO_$V,  alias=FOO] and                
  //       [BRIDGE = src=FOO_ALL, alias=FOO]

	auto_bridge_appcast = true
	
  qbridge  = DEPLOY, RETURN, STATION_KEEP, NODE_REPORT, NODE_MESSAGE
  qbridge  = MOOS_MANUAL_OVERRIDE, AVOID, UP_LOITER
  qbridge  = RETURN_UPDATES, BCM_DISPLAY_RADII
  qbridge  = CONTACT_INFO, NODE_GROUP_UPDATE
  qbridge  = BHV_ABLE_FILTER
  // Mission mode triggers (from operator or mothership coordinator)
  qbridge  = SURVEY, TARGET_ALERT, LOITER, SHORE_HEARTBEAT
  qbridge  = WPT_UPDATE, TRAIL_UPDATE, SUSPECT_TARGET

  bridge   = src=UP_LOITER_$N, alias=UP_LOITER
  bridge   = src=DRIFT_VECTOR_ADD, alias=DRIFT_VECTOR_ADD
  bridge   = src=HELM_MAP_CLEAR, alias=HELM_MAP_CLEAR
  bridge   = src=MISSION_HASH, alias=MISSION_HASH
}

//--------------------------------------------------
// uFldNodeComms Config Block

ProcessConfig = uFldNodeComms
{
  AppTick   = 2
  CommsTick = 2

  comms_range      = 500
  critical_range   = 25
  min_msg_interval = 15
  max_msg_length   = 1000
  groups           = true

	app_logging = true
	
  view_node_rpt_pulses = false
}

//--------------------------------------------------
// pLogger Config Block

ProcessConfig = pLogger
{
  AppTick       = 10
  CommsTick     = 10
  
  File          = XLOG_SHORESIDE
  PATH          = ./
  SyncLog       = true @ 0.2
  AsyncLog      = true
  FileTimeStamp = true

  LogAuxSrc     = true

  // Log it all!!!!!
  WildCardLogging = true 

  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = *_ITER_GAP
  WildCardOmitPattern = *_ITER_LEN
}

//--------------------------------------------------
// uLoadWatch Config Block

ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1

  thresh = app=pHelmIvP,  gapthresh=3
  thresh = app=pHostInfo, gapthresh=5
  thresh = app=any,       gapthresh=2.0
  thresh = app=uMemWatch, gapthresh=50

  breach_trigger = 5
}

//--------------------------------------------------------
ProcessConfig = pMarineViewer
{
  AppTick    = 4
  CommsTick  = 4

  watch_cluster = key=basic, vars=MISSION_HASH

  tiff_file            = forrest19.tif
  set_pan_x            = -90
  set_pan_y            = -280
  zoom                 = 0.65
  vehicles_shape_scale = 1.5
  vehicles_name_mode   = names

	app_logging = true
	
	watch_cluster = key=mission_top, vars=DEPLOY:RETURN
	watch_cluster = key=mission_top, vars=STATION_KEEP:LOITER:AVOID
	
  circle_viewable_all = false

	content_mode      = appcast       // or realmcast
	realmcast_channel = mission_top
	
  appcast_color_scheme = indigo
	appcast_font_size    = large
  procs_font_size      = large
  nodes_font_size      = large

  // NOTE on time-warp: AppTick schedules each process's real
  // wall-clock iteration rate -- MOOSTimeWarp only speeds up the
  // *timestamp value* MOOSTime() returns, not that real schedule. So
  // at high warp, ordinary OS scheduling jitter (a fleet of 5 full
  // MOOS communities competing for CPU, a logger's disk flush, etc.)
  // gets amplified by the warp factor in simulated seconds: a stall
  // of a couple of real seconds at warp=10 looks like a 20+ sim-second
  // gap between NODE_REPORTs. The old 10/18 thresholds (28 sim-sec
  // total) were tight enough that this routinely tripped false
  // "stale" and removed healthy vehicles from the chart at warp>=10.
  // These are back near the pMarineViewer stock default (30/30).
  stale_report_thresh = 20
  stale_remove_thresh = 40

	scope = REALMCAST_REQ
	scope = REALMCAST_REQ_GILDA
	scope = REALMCAST_REQ_HENRY
	
  left_context[disable] = BHV_ABLE_FILTER_$[UP_VNAME_CLOSEST] = contact=abe, action=disable
  left_context[return_point] = RETURN_$[UP_VNAME_CLOSEST] = true
  left_context[return_point] = RETURN_UPDATES_$[UP_VNAME_CLOSEST] = points=$[XPOS],$[YPOS]
  left_context[station]      = STATION_KEEP_$[UP_VNAME_CLOSEST] = true

  // Draw the search region: pick "region" in the mouse-context menu,
  // then left-click each corner. pRegionDivider takes the convex hull
  // of the clicks, so click order does not matter; three clicks are
  // enough and every further click refines the shape.
  left_context[region] = REGION_VERTEX = x=$[XPOS],y=$[YPOS]

  // Draw the intruder's patrol route: pick "target_path" in the mouse
  // context menu, then left-click the waypoints IN ORDER. Unlike the
  // region, click order is the route order and the shape need not be
  // convex. The route takes effect as soon as there are two points.
  left_context[target_path] = TARGET_PATH_VERTEX = x=$[XPOS],y=$[YPOS]

  cmd = label=DEPLOY, var=DEPLOY,              sval=true,  receivers=all:$(VNAMES)
  cmd = label=DEPLOY, var=MOOS_MANUAL_OVERRIDE, sval=false, receivers=all:$(VNAMES)
  cmd = label=DEPLOY, var=AVOID,               sval=true,  receivers=all:$(VNAMES)
  cmd = label=DEPLOY, var=RETURN,              sval=false, receivers=all:$(VNAMES)
  cmd = label=DEPLOY, var=STATION_KEEP,        sval=false, receivers=all:$(VNAMES)

  cmd = label=RETURN, var=RETURN,        sval=true,  receivers=all:$(VNAMES)
  cmd = label=RETURN, var=STATION_KEEP,  sval=false, receivers=all:$(VNAMES)

  // Survey mode: vehicles begin coordinated area search
  cmd = label=SURVEY, var=SURVEY,        sval=true,  receivers=all:$(VNAMES)
  cmd = label=SURVEY, var=LOITER,        sval=false, receivers=all:$(VNAMES)
  cmd = label=SURVEY, var=TARGET_ALERT,  sval=false, receivers=all:$(VNAMES)

  // Intercept mode: vehicles trail the suspect target
  cmd = label=INTERCEPT, var=TARGET_ALERT, sval=true,  receivers=all:$(VNAMES)
  cmd = label=INTERCEPT, var=SURVEY,       sval=false, receivers=all:$(VNAMES)

  cmd = label=LOITER-FAST, var=UP_LOITER, sval=speed=2.8, receivers=all:$(VNAMES)
  cmd = label=LOITER-SLOW, var=UP_LOITER, sval=speed=1.4, receivers=all:$(VNAMES)

  cmd = label=LOITER-CLOCKWISE-TRUE,  var=UP_LOITER, sval=clockwise=true,  receivers=all:$(VNAMES)
  cmd = label=LOITER-CLOCKWISE-FALSE, var=UP_LOITER, sval=clockwise=false, receivers=all:$(VNAMES)
	
  // Each button posts the COMPLETE mode state rather than only the bits
  // that changed. Leaving stale flags behind (SURVEY still true under
  // RETURN, TARGET_ALERT still true under a second DEPLOY) is what made
  // the vehicles behave unpredictably when the mission was re-run.
  //
  // DEPLOY goes straight to SURVEY. There used to be a 10-second
  // LOITERING window first, during which each USV drew its loiter
  // octagon at a hard-coded default position -- the stray polygon that
  // flashed on the chart for a few seconds after every deploy, sitting
  // nowhere near the region the operator had just drawn.
  button_one   = DEPLOY # DEPLOY_ALL=true
  button_one   = MOOS_MANUAL_OVERRIDE_ALL=false
  button_one   = AVOID_ALL=true
  button_one   = RETURN_ALL=false # STATION_KEEP_ALL=false
  button_one   = SURVEY_ALL=true # LOITER_ALL=false
  button_one   = TARGET_ALERT_ALL=false

  button_two   = RETURN # RETURN_ALL=true
  button_two   = STATION_KEEP_ALL=false
  button_two   = SURVEY_ALL=false # TARGET_ALERT_ALL=false

  button_three = SURVEY # SURVEY_ALL=true
  button_three = LOITER_ALL=false
  button_three = TARGET_ALERT_ALL=false
  button_three = RETURN_ALL=false # STATION_KEEP_ALL=false

  button_four  = INTERCEPT # TARGET_ALERT_ALL=true
  button_four  = SURVEY_ALL=false # LOITER_ALL=false
  button_four  = RETURN_ALL=false # STATION_KEEP_ALL=false

  button_five  = STATION:true  # STATION_KEEP_ALL=true
  button_six   = STATION:false # STATION_KEEP_ALL=false

	button_seven = REFINE:N # CONTACT_INFO_ALL = name=avdcol # use_refinery=false
	button_eight = REFINE:Y # CONTACT_INFO_ALL = name=avdcol # use_refinery=true

  // Hand the operator's mission region up to the mothership region divider
  // Region controls. Draw by picking "region" in the mouse-context
  // menu and left-clicking corners; these two are the reset and the
  // fall-back default.
  button_nine  = REGION:CLEAR # REGION_CLEAR = true
  button_ten   = REGION:DEFAULT # MISSION_POLY = pts={-70,-10:210,-10:210,-130:-70,-130}

  // Search pattern. Re-plans and re-tasks both USVs immediately, so
  // the patterns can be compared against each other mid-mission.
  //   LAWN   - adjacent lanes; shortest path, tightest 180s
  //   SKIP   - every other lane out, the missed ones back; the turns
  //            are then two lane widths wide instead of one, which is
  //            what actually removes the hard cornering
  //   SPIRAL - inward rectangular spiral of the band
  //   PERIM  - single boundary loop of the band
  button_eleven   = PAT:LAWN   # SEARCH_PATTERN = lawnmower
  button_twelve   = PAT:SKIP   # SEARCH_PATTERN = skip
  button_thirteen = PAT:SPIRAL # SEARCH_PATTERN = spiral
  button_fourteen = PAT:PERIM  # SEARCH_PATTERN = perimeter

  // Sensor (visual) range. Lane spacing is 2*range less a 10% seam and
  // the lane ends are pulled in by 0.7*range, so a longer range means
  // fewer, shorter lanes and noticeably less distance driven. Watch the
  // "Path Length" column in the pRegionDivider appcast change.
  button_fifteen  = SEE:10m # SENSOR_RADIUS = 10
  button_sixteen  = SEE:20m # SENSOR_RADIUS = 20
  button_seventeen = SEE:30m # SENSOR_RADIUS = 30

  // Intruder route drawing (see left_context[target_path] above).
  button_eighteen = TGT:UNDO  # TARGET_PATH_UNDO = true
  button_nineteen = TGT:CLEAR # TARGET_PATH_CLEAR = true
  button_twenty   = TGT:APPLY # TARGET_PATH_APPLY = true
}

//--------------------------------------------------------
// uTimerScript_Heartbeat Config Block
// Free-running: the vehicles' link watchdogs should see a heartbeat from
// the moment they come up, not only once the operator has deployed.
ProcessConfig = uTimerScript_Heartbeat
{
  AppTick   = 4
  CommsTick = 4
  
  reset_max  = unlimited
  reset_time = 2

  // Send heartbeat every 2 seconds
  event = var=SHORE_HEARTBEAT_ALL, val=true, time=2
}


