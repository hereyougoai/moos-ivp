//-------------------------------------------------
// Vehicle MOOS config file
// M. Benjamin, MIT

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plugs.moos <origin_warp>

//----------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 50
   
  Run = MOOSDB         @ NewConsole = false
  Run = uProcessWatch  @ NewConsole = false
  Run = pShare         @ NewConsole = false
  Run = pLogger        @ NewConsole = false
  Run = pNodeReporter  @ NewConsole = false
  Run = pMarinePIDV22  @ NewConsole = false
  Run = pHelmIvP       @ NewConsole = false
  Run = pHostInfo      @ NewConsole = false
  Run = uFldNodeBroker @ NewConsole = false
  Run = uLoadWatch     @ NewConsole = false
  Run = uMemWatch      @ NewConsole = false
  Run = pContactMgrV20 @ NewConsole = false
  Run = pObstacleMgr   @ NewConsole = false
  Run = pLandGuard     @ NewConsole = false
  Run = pRealm         @ NewConsole = false
  Run = uTimerScript   @ NewConsole = false

#ifdef XMODE SIM
  Run = uSimMarineV22  @ NewConsole = false
#elseifdef XMODE M300
  Run = iM300          @ NewConsole = false
#endif
	}

#ifdef XMODE SIM
#include plugs.moos <uSimMarine>
#elseifdef XMODE M300
#include plugs.moos <iM300>
#endif
	
#include plugs.moos <pShare>
#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

// Charted land. Feeds OBSTACLE_ALERT to the templated BHV_AvoidObstacleV24
// in the .bhv file. Regenerate with ./gen_land.py -- never edit by hand.
#include plug_land_obstacles.moos
#include plugs.moos <pLandGuard>

//----------------------------------------------------
// pHelmIvP Config Block  

ProcessConfig = pHelmIvP
{
  AppTick    = 4
  CommsTick  = 4

  behaviors    = targ_$(VNAME).bhv  
  verbose      = false
  domain       = course:0:359:360
  domain       = speed:0:$(MAX_SPD):31

	app_logging = true
	
	hold_on_apps = pContactMgrV20
}
	
//----------------------------------------------------
// pNodeReporter Config Block 

ProcessConfig = pNodeReporter
{
  AppTick     = 2
  CommsTick   = 2

	platform_color = $(COLOR)
  vessel_type    = $(VTYPE=kayak)
  //terse_reports  = true

	//json_report = NODE_REPORT_JSON
	
	coord_policy_global = true
}

//--------------------------------------------------------
// pContactMgrV20 Config Block

ProcessConfig = pContactMgrV20
{
  AppTick   = 2
  CommsTick = 2

  decay = 30,60

	app_logging = true
	
  alert_verbose = true

	contact_local_coords = force_lat_lon
	
  contact_max_age   = 35
  display_radii     = true
	display_radii_id  = avd
  alert_range_color = gray70
  cpa_range_color   = gray30

  // RANGES: alert_range is the range at which the avoidance behavior is
  // SPAWNED; cpa_range is the wider range inside which a closing CPA
  // also triggers it. cpa_range must therefore be >= alert_range --
  // CMAlert::setAlertRangeFar() silently clamps alert_range DOWN to
  // cpa_range when it is smaller.
  //
  // This block used to read "alert_range=15, cpa_range=5", which by
  // that clamp meant the collision-avoidance behavior was not created
  // until a contact was within FIVE METRES. Two USVs closing head-on at
  // 2 m/s each had 1.2 seconds of it. Action that early enough to be
  // a single readily-apparent alteration is not reachable from 5 m.
  //
  // 60 m spawn at a 4 m/s head-on closing speed is 15 seconds, which is
  // ample time on a 280x120 m field, and leaves room for the behavior's
  // own 45 m pwt_outer_dist to do the work.
  alert = id=avdcol_, var=CONTACT_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdcol_, alert_range=60, cpa_range=75
  alert = id=avdcol_, ignore_name=target

  // The designated intruder is handled by its own avoidance instance.
  // Same CPA metric as the fleet instance above, but the distances are
  // scaled to the interception standoff, so holding station at 25 m off
  // the target does not sit permanently inside the avoidance band and
  // fight BHV_Trail. The 14 m min_util_cpa_dist below is the floor the
  // interception may not breach.
  alert = id=avdtgt_, var=TGT_AVD_INFO, val="name=$[VNAME] # contact=$[VNAME]"
  alert = id=avdtgt_, alert_range=32, cpa_range=45
  alert = id=avdtgt_, match_name=target

  // CONTACT-DRIVEN DETECTION.
  //
  // This USV's own contact manager decides whether the intruder is a
  // contact within sensor range, and reports only the transitions --
  // on when it comes inside, off when it drops out. pTargetCoordinator
  // on the mothership engages on those reports.
  //
  // It used to be a range comparison on the mothership against the
  // NODE_REPORT the intruder broadcasts about itself twice a second.
  // That is ground truth handed over by the simulator; no sensor
  // provides it, and an uncooperative vessel certainly does not. This
  // is the seam a real sensor plugs into: replace the simulated
  // NODE_REPORT source with radar / AIS / EO tracks and everything
  // above the contact manager is unchanged.
  //
  // alert_range is the detection range and is the SAME number as the
  // search plan's sensor radius -- the Sensor Range menu updates both,
  // posting SENSOR_RADIUS for the planner and a BCM_ALERT_REQUEST for
  // this alert. cpa_range is kept 25% wider so a contact that is
  // closing is picked up slightly early and does not chatter on and
  // off at the boundary.
  //
  // SEPARATOR: ':' and not '#'. pContactMgrV20 is asymmetric about it --
  // CMAlert::addAlertOnFlag() takes the whole string as one value (the
  // '#'-splitting version of it is sitting under an #if 0), while
  // addAlertOffFlag() still splits on '#' and turns each piece into its
  // own MOOS variable. Written with '#', the off transition therefore
  // posted "SUSPECT_REPORT = vname=abe" plus two stray variables
  // literally named "contact" and "state", so "state=off" never reached
  // the coordinator, the contact latch never cleared, and every later
  // entry into the search region was treated as a fresh detection.
  alert = id=suspect_, on_flag = SUSPECT_REPORT = vname=$(VNAME):contact=$[VNAME]:state=on
  alert = id=suspect_, off_flag = SUSPECT_REPORT = vname=$(VNAME):contact=$[VNAME]:state=off
  alert = id=suspect_, alert_range=45, cpa_range=56
  alert = id=suspect_, match_name=target

	
	//match_region = pts = {60,-40 : 60,-160 : 150,-160 : 180,-100 : 150,-40}
	//match_type = kayak, uuv

  disable_var = XYZ_DISABLE_TARGET
  enable_var  = XYZ_REENABLE_TARGET
	
	post_closest_range   = true
  hold_alerts_for_helm = true
}

//--------------------------------------------------
// uFldNodeBroker Config Block

ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1

  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

	//shadow_shore = ip=192.168.7.22, name=henry, dur=45000
	
  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_CIRCLE
  bridge = src=VIEW_POINT
  bridge = src=VIEW_SEGLIST
  bridge = src=NODE_REPORT_LOCAL,  alias=NODE_REPORT
  bridge = src=NODE_MESSAGE_LOCAL, alias=NODE_MESSAGE
}

//--------------------------------------------------
// uLoadWatch Config Block

ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1

  thresh = app=pHelmIvP,  gapthresh=3
  thresh = app=pHostInfo, gapthresh=5
  thresh = app=any,       gapthresh=2.0
  thresh = app=uMemWatch, gapthresh=50
  thresh = app=uSimMarineV22, gapthresh=3

  breach_trigger = 5
}

//--------------------------------------------------------
// uMemWatch Config Block

ProcessConfig = uMemWatch
{
  AppTick   = 0.4
  CommsTick = 0.4

  absolute_time_gap = 2
  watch_only = pHelmIvP
}

//-----------------------------------------------------
// pMarinePIDV22 Config Block

ProcessConfig = pMarinePIDV22
{
  AppTick    = 10
  CommsTick  = 10

  verbose       = true
  depth_control = false
  active_start  = true
  
  // Yaw PID controller
  // Tuned for trailing: while shadowing a turning target the heading
  // setpoint moves constantly, so the integral term only winds up and
  // overshoots each corner -- dropped to zero. The raised derivative
  // term damps the resulting rudder motion.
  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.3
  yaw_pid_ki             = 0.0
  yaw_pid_integral_limit = 0.07
  
  // Speed PID controller
  speed_pid_kp           = 1.0
  speed_pid_kd           = 0.0
  speed_pid_ki           = 0.0
  speed_pid_integral_limit = 0.07
  
  // Maximums
  maxrudder  = 100
  maxthrust  = 100
  
  // A non-zero SPEED_FACTOR overrides use of SPEED_PID
  // Will set DESIRED_THRUST = DESIRED_SPEED * SPEED_FACTOR
  speed_factor = 20
}

//--------------------------------------------------
// pLogger Config Block

ProcessConfig = pLogger
{
  AppTick 	= 5
  CommsTick = 5
  
  File          = LOG_%(VNAME)
  PATH	        = ./
  AsyncLog 	    = true
  FileTimeStamp = true

  Log = IVPHELM_LIFE_EVENT @ 0 nosync
  Log = BCM_ALERT_REQUEST @ 0 nosync

  LogAuxSrc = true

  // Log it all!!!!!
  WildCardLogging = true 
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = APPCAST
  WildCardOmitPattern = DB_VARSUMMARY
//  WildCardOmitPattern = DB_RWSUMMARY

  //WildCardOmitPattern = NAV_LAT, NAV_LONG
  WildCardOmitPattern = NAV_PITCH, NAV_YAW, NAV_Z
  WildCardOmitPattern = SIMULATION_MODE, TRUE_X, TRUE_Y
  WildCardOmitPattern = NAV_DEPTH, NAV_SPEED_OVER_GROUND, DB_QOS
  //WildCardOmitPattern = NODE_BROKER_PING_0, PSHARE*
  WildCardOmitPattern = IVPHELM_ALLSTOP_DEBUG, *ITER_GAP, *ITER_LEN
  WildCardOmitPattern = PHI_HOST*

  // WildCardOmitPattern = DB_CLIENTS
  // WildCardOmitPattern = PHI_HOST*, NODE_REPORT_LOCAL
}

//--------------------------------------------------
// uTimerScript Config Block - Heartbeat Monitor
//
// Watchdog for a lost shoreside link. Two things used to make this
// misfire and leave a vehicle uncontrollable:
//
//   1) The timeout was 10 script-seconds. Script time is warped, so
//      at WARP=10 a mere 1 second of real-world scheduling jitter
//      tripped it, even though the shoreside was still there.
//   2) It posted MOOS_MANUAL_OVERRIDE=true. That parks the helm but
//      leaves pMarinePIDV22 (active_start=true) driving the last
//      DESIRED_HEADING/DESIRED_SPEED forever -- the vehicle circles
//      away at speed and nothing but a fresh DEPLOY recovers it.
//
// Now: a 60s timeout (30 heartbeats' worth of margin) and the only
// action is STATION_KEEP, which brings the vehicle to a controlled
// hold and is cleared again by DEPLOY or the STATION:false button.
ProcessConfig = uTimerScript
{
  AppTick   = 2
  CommsTick = 2

  // Start script only if vehicle is DEPLOYED
  condition  = DEPLOY == true
  
  // Reset the timer whenever a heartbeat is received from shoreside
  reset_var  = SHORE_HEARTBEAT
  reset_max  = unlimited
  reset_time = end

  // If 60s pass without a heartbeat, come to a controlled stop.
  event = var=STATION_KEEP, val=true, time=60
}
