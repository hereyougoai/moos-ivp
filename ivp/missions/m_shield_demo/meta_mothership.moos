//--------------------------------------------------------
// Mothership Config file
// Acts as the fleet coordinator for m_shield_demo
// Communicates with vehicles via shoreside's pShare bridge
//
// Port layout:
//   MOOSDB    : $(MOOS_PORT)  [default 9005]
//   pShare in : $(PSHARE_PORT) [default 9205]
//   pShare out: $(SHORE_PSHARE) [default 9200, shoreside]

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = mothership

#include plugs.moos <origin_warp>
  
//--------------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false

  // Coordinator apps
  Run = pRegionDivider     @ NewConsole = false
  Run = pTargetCoordinator @ NewConsole = false
}

#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// pShare Config Block
//
// Coordinator commands go STRAIGHT DOWN to the sub-vessels.
// They must not be relayed via the shoreside: pShare refuses to inject
// an inbound variable into its local DB when it also holds an outbound
// route of the same name, and uFldShoreBroker creates exactly such a
// route for every qbridged variable (WPT_UPDATE_ABE -> WPT_UPDATE).

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2

  // Inbound: NODE_REPORTs from every vessel, MISSION_POLY + DEPLOY_ALL
  // from the shoreside.
  input = route = localhost:$(PSHARE_PORT)

  // Outbound: per-vehicle tasking, delivered on the vehicle's own name.
  output = src_name=WPT_UPDATE_ABE,     dest_name=WPT_UPDATE,     route=localhost:$(USV1_PSHARE=9201)
  output = src_name=WPT_UPDATE_BEN,     dest_name=WPT_UPDATE,     route=localhost:$(USV2_PSHARE=9202)
  output = src_name=TRAIL_UPDATE_ABE,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV1_PSHARE=9201)
  output = src_name=TRAIL_UPDATE_BEN,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV2_PSHARE=9202)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV1_PSHARE=9201)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV2_PSHARE=9202)

  // Coordinator's own visuals (mission region outline + the swept
  // coverage grid) go up to the shoreside so the operator sees them.
  output = src_name=VIEW_POLYGON,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID,       route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID_DELTA, route=localhost:$(SHORE_PSHARE)
  // The pincer arms and station markers drawn by pTargetCoordinator.
  output = src_name=VIEW_SEGLIST,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_POINT,      route=localhost:$(SHORE_PSHARE)
}

ProcessConfig = pLogger
{
  AppTick       = 10
  CommsTick     = 10
  File          = XLOG_MOTHERSHIP
  PATH          = ./
  SyncLog       = true @ 0.2
  AsyncLog      = true
  FileTimeStamp = true
  LogAuxSrc     = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//--------------------------------------------------
// pRegionDivider Config Block
//
// Plans the fleet's sweep of the operator's MISSION_POLY (or, absent
// that, a default region) and posts each vehicle a WPT_UPDATE_<VNAME>
// point list.
//
// Three things about the plan are worth knowing:
//
//  1. The lanes run along the region's own long axis, found from the
//     minimum-area bounding rectangle, not along a fixed east-west
//     compass line. A region drawn on a diagonal used to be swept in
//     many short east-west lanes with a hard 180 at the end of each;
//     now the lanes follow the region and there are far fewer turns.
//
//  2. The region is cut into one band per vehicle ACROSS that lane
//     axis. Cutting the other way (the old west->east strips) halves
//     the length of every lane and so doubles the number of turns for
//     exactly the same water covered.
//
//  3. Lane spacing is not a fixed number; it comes from sensor_radius.
//     A sensor seeing 15 m in every direction covers a 30 m swath, so
//     lanes sit 27 m apart (10% seam) rather than the old fixed 20 m,
//     and the lane ends stop 0.7*15 m short of the boundary because
//     the sensor already sees that far ahead. Both cut distance driven
//     without leaving water unsearched.

ProcessConfig = pRegionDivider
{
  AppTick   = 2
  CommsTick = 2

  vnames = $(VNAMES)

  // Operator-selectable at run time via SEARCH_PATTERN
  // (lawnmower | skip | spiral | perimeter) -- see the PAT:* buttons.
  pattern     = lawnmower

  // "auto" takes the sweep direction from the region shape. Force it
  // with east-west / north-south if a fixed heading is wanted.
  sweep_align = auto

  // Sensor / visual range, in metres. Drives the lane spacing, the
  // lane-end trimming, and the coverage shading. Adjustable at run
  // time via SENSOR_RADIUS (the SEE:* buttons).
  sensor_radius   = 15
  auto_lane_width = true
  lane_overlap    = 0.10
  endpoint_inset  = 0.70

  cell_size = 10

  // Falls back to this if DEPLOY_ALL fires before the operator has
  // ever pressed REGION to send a MISSION_POLY up from the shoreside.
  default_region = pts={-70,-10:210,-10:210,-130:-70,-130}
}

//--------------------------------------------------
// pTargetCoordinator Config Block
// While TARGET_ALERT_ALL is true, puts the vehicles in $(VNAMES) on a
// blocking arc between the target and the middle of the search region
// (REGION_CENTER, published by pRegionDivider) and posts each an
// absolute-bearing TRAIL_UPDATE_<VNAME>. The pair therefore stands
// between the intruder and the water it wants, and its own collision
// avoidance drives it outward -- a pincer, not a tail chase.

ProcessConfig = pTargetCoordinator
{
  AppTick   = 2
  CommsTick = 2

  vnames      = $(VNAMES)
  target_name = target

  pincer_mode = herd   // or "stern" for the old astern-fan behavior

  // 120 deg apart on the inboard arc: the two USVs sit roughly on the
  // target's beams rather than in a queue behind it, which is what
  // makes the envelopment visible and gives its avoidance behavior
  // pressure from both sides at once.
  spread_deg  = 120

  // Inside the target's own BHV_AvoidCollision pwt_inner_dist (25m),
  // so the herding pressure is continuous rather than a single dodge.
  trail_range = 25

  // Hysteresis on the station pairing. Without it the two USVs traded
  // stations at 2 Hz once they were near-symmetric about the target,
  // and both just spun in place.
  swap_margin_deg = 30

  // Within this of the region center the "outboard" direction is
  // meaningless, so the arc falls back to the target's stern.
  center_deadzone = 20

  repost_interval = 4
  draw_pincer     = true
}

