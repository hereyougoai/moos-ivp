//--------------------------------------------------------
// Mothership Config file
// Acts as the fleet coordinator for m_shield_demo
// Communicates with vehicles via shoreside's pShare bridge
//
// Port layout:
//   MOOSDB    : $(MOOS_PORT)  [default 9005]
//   pShare in : $(PSHARE_PORT) [default 9205]
//   pShare out: $(SHORE_PSHARE) [default 9200, shoreside]

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = mothership

#include plugs.moos <origin_warp>
  
//--------------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false

  // Coordinator apps
  Run = pRegionDivider     @ NewConsole = false
  Run = pTargetCoordinator @ NewConsole = false
}

#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// pShare Config Block
//
// Coordinator commands go STRAIGHT DOWN to the sub-vessels.
// They must not be relayed via the shoreside: pShare refuses to inject
// an inbound variable into its local DB when it also holds an outbound
// route of the same name, and uFldShoreBroker creates exactly such a
// route for every qbridged variable (WPT_UPDATE_ABE -> WPT_UPDATE).

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2

  // Inbound: NODE_REPORTs from every vessel, MISSION_POLY + DEPLOY_ALL
  // from the shoreside.
  input = route = localhost:$(PSHARE_PORT)

  // Outbound: per-vehicle tasking, delivered on the vehicle's own name.
  output = src_name=WPT_UPDATE_ABE,     dest_name=WPT_UPDATE,     route=localhost:$(USV1_PSHARE=9201)
  output = src_name=WPT_UPDATE_BEN,     dest_name=WPT_UPDATE,     route=localhost:$(USV2_PSHARE=9202)
  output = src_name=TRAIL_UPDATE_ABE,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV1_PSHARE=9201)
  output = src_name=TRAIL_UPDATE_BEN,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV2_PSHARE=9202)

  // Blocking stations (pincer_mode=block). BLOCK_UPDATE carries the
  // ground-fixed point; BLOCK_ACTIVE is the switch the station-keeping
  // behavior is conditioned on, and it also disables BHV_Trail so the
  // two never fight over the same vehicle.
  output = src_name=BLOCK_UPDATE_ABE,   dest_name=BLOCK_UPDATE,   route=localhost:$(USV1_PSHARE=9201)
  output = src_name=BLOCK_UPDATE_BEN,   dest_name=BLOCK_UPDATE,   route=localhost:$(USV2_PSHARE=9202)
  output = src_name=BLOCK_ACTIVE_ABE,   dest_name=BLOCK_ACTIVE,   route=localhost:$(USV1_PSHARE=9201)
  output = src_name=BLOCK_ACTIVE_BEN,   dest_name=BLOCK_ACTIVE,   route=localhost:$(USV2_PSHARE=9202)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV1_PSHARE=9201)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV2_PSHARE=9202)

  // Automatic engagement: pTargetCoordinator raises the alert when an
  // intruder is detected and drops it again once the intruder has been
  // driven off. These deliberately carry their own names rather than
  // reusing TARGET_ALERT_ALL / SURVEY_ALL: those arrive here from the
  // shoreside, and pShare refuses to inject an inbound variable into
  // the local DB once an outbound route of the same name exists, so
  // publishing them under the same name would silently kill the
  // operator's own INTERCEPT and SURVEY buttons. They land on the
  // vehicles as the same TARGET_ALERT / SURVEY the operator drives.
  output = src_name=TARGET_ALERT_AUTO, dest_name=TARGET_ALERT, route=localhost:$(USV1_PSHARE=9201)
  output = src_name=TARGET_ALERT_AUTO, dest_name=TARGET_ALERT, route=localhost:$(USV2_PSHARE=9202)
  output = src_name=SURVEY_AUTO,       dest_name=SURVEY,       route=localhost:$(USV1_PSHARE=9201)
  output = src_name=SURVEY_AUTO,       dest_name=SURVEY,       route=localhost:$(USV2_PSHARE=9202)

  // Coordinator's own visuals (mission region outline + the swept
  // coverage grid) go up to the shoreside so the operator sees them.
  output = src_name=VIEW_POLYGON,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID,       route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID_DELTA, route=localhost:$(SHORE_PSHARE)
  // The pincer arms, detection rings and station markers drawn by
  // pTargetCoordinator.
  output = src_name=VIEW_SEGLIST,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_POINT,      route=localhost:$(SHORE_PSHARE)

  // Engagement-cycle readout, so the operator can see detections and
  // successful evictions on the shoreside scope.
  output = src_name=SHIELD_STATE,      route=localhost:$(SHORE_PSHARE)
  output = src_name=SHIELD_DETECTIONS, route=localhost:$(SHORE_PSHARE)
  output = src_name=SHIELD_EVICTIONS,  route=localhost:$(SHORE_PSHARE)
}

ProcessConfig = pLogger
{
  AppTick       = 10
  CommsTick     = 10
  File          = XLOG_MOTHERSHIP
  PATH          = ./
  SyncLog       = true @ 0.2
  AsyncLog      = true
  FileTimeStamp = true
  LogAuxSrc     = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//--------------------------------------------------
// pRegionDivider Config Block
//
// Plans the fleet's sweep of the operator's MISSION_POLY (or, absent
// that, a default region) and posts each vehicle a WPT_UPDATE_<VNAME>
// point list.
//
// Three things about the plan are worth knowing:
//
//  1. The lanes run along the region's own long axis, found from the
//     minimum-area bounding rectangle, not along a fixed east-west
//     compass line. A region drawn on a diagonal used to be swept in
//     many short east-west lanes with a hard 180 at the end of each;
//     now the lanes follow the region and there are far fewer turns.
//
//  2. The region is cut into one band per vehicle ACROSS that lane
//     axis. Cutting the other way (the old west->east strips) halves
//     the length of every lane and so doubles the number of turns for
//     exactly the same water covered.
//
//  3. Lane spacing is not a fixed number; it comes from sensor_radius.
//     A sensor seeing 15 m in every direction covers a 30 m swath, so
//     lanes sit 27 m apart (10% seam) rather than the old fixed 20 m,
//     and the lane ends stop 0.7*15 m short of the boundary because
//     the sensor already sees that far ahead. Both cut distance driven
//     without leaving water unsearched.

ProcessConfig = pRegionDivider
{
  AppTick   = 2
  CommsTick = 2

  vnames = $(VNAMES)

  // Operator-selectable at run time via SEARCH_PATTERN
  // (lawnmower | skip | spiral | perimeter) -- see the PAT:* buttons.
  pattern     = lawnmower

  // "auto" takes the sweep direction from the region shape. Force it
  // with east-west / north-south if a fixed heading is wanted.
  sweep_align = auto

  // Sensor / visual range, in metres. Drives the lane spacing, the
  // lane-end trimming, and the coverage shading. Adjustable at run
  // time via SENSOR_RADIUS (the SEE:* buttons).
  sensor_radius   = 45
  auto_lane_width = true
  lane_overlap    = 0.10
  endpoint_inset  = 0.70

  cell_size = 10

  // Falls back to this if DEPLOY_ALL fires before the operator has
  // ever pressed REGION to send a MISSION_POLY up from the shoreside.
  default_region = pts={-70,-10:210,-10:210,-130:-70,-130}
}

//--------------------------------------------------
// pTargetCoordinator Config Block
// While TARGET_ALERT_ALL is true, puts the vehicles in $(VNAMES) on a
// blocking arc between the target and the middle of the search region
// (REGION_CENTER, published by pRegionDivider) and posts each an
// absolute-bearing TRAIL_UPDATE_<VNAME>. The pair therefore stands
// between the intruder and the water it wants, and its own collision
// avoidance drives it outward -- a pincer, not a tail chase.

ProcessConfig = pTargetCoordinator
{
  AppTick   = 2
  CommsTick = 2

  vnames      = $(VNAMES)
  target_name = target

  // block = ground-fixed blocking stations ahead of the intruder, the
  //         only geometry that actually makes it turn. See the long
  //         note in assignAndPostBlock() and the block_* settings at
  //         the end of this block.
  // herd  = the old trail arc: two USVs holding an absolute bearing off
  //         the intruder at trail_range. Kept for comparison. It does
  //         not evict -- BHV_Trail matches the contact's velocity once
  //         on station, so the intruder's avoidance sees a flat
  //         objective function and never turns.
  // stern = the older astern fan.
  pincer_mode = herd

  // This is only the STARTING formation. The operator's Action/Eviction
  // Formation menu on the shoreside posts EVICT_FORMATION, which
  // switches between the same three (and can set the arc spread in the
  // same message) while the engagement is running -- so the three
  // tactics can be compared against one intrusion. Renaming the
  // variable, or disabling the switch entirely (formation_var = ""),
  // is done here.
  formation_var = EVICT_FORMATION

  // 90 deg apart on the inboard arc: the two USVs sit on the target's
  // forward quarters rather than in a queue behind it, which gives its
  // avoidance behavior strong inward pressure from both sides.
  spread_deg  = 90

  // The station has to satisfy two things at once: close enough to be
  // inside the intruder's own avoidance band (pwt_outer_dist 55) so the
  // pressure is continuous rather than a single dodge, and far enough
  // out that it is NOT inside the USV's own avoidance band for the
  // intruder (pwt_outer_dist 30) -- otherwise the two behaviors fight
  // and the pass ends up closer than either asked for.
  //
  // 30 m sits in the window (22 < 30 < 55) and, crucially, at or inside
  // the intruder's pwt_inner_dist of 25-ish where its avoidance is at
  // full relevance rather than ramping. At 40 m the wall was sitting in
  // the ramp between the intruder's inner (25) and outer (55)
  // distances, so it pushed at partial strength: the intruder could
  // orbit the region centre for several laps before the pressure
  // accumulated enough to squeeze it out.
  trail_range = 30

  // Hard floor, so a later edit to trail_range cannot quietly put the
  // fleet back inside the avoidance band. Rule 8(d): action taken to
  // avoid collision must "result in passing at a safe distance".
  min_standoff = 25

  // CANT ANGLE — how far each USV's BOW is turned IN, in degrees.
  //
  // The baseline (0) is EXACTLY PARALLEL to the intruder: on station
  // BHV_Trail steers ownship at the contact's own course, so with no
  // cant the pair runs abreast of the intruder on its own heading. This
  // number turns each bow off that baseline, toward the intruder's
  // centreline -- the higher it is, the more each USV is cutting in
  // rather than escorting alongside.
  //
  // It moves the BOW ONLY. The stations stay spread_deg apart on the arc
  // at trail_range, and the speed is still matched, so nothing about the
  // standoff or the shape of the formation changes -- only what the two
  // USVs are pointing at. The coordinator signs it per vehicle from the
  // side each one is standing on, so one non-negative number here means
  // "inward" for both; it is capped at 90, past which the bow would be
  // turning back across the track rather than in toward it.
  //
  // Only meaningful in the trail-arc modes (herd/stern): in block mode
  // the USVs are stopped on a station-keeping point and have no held
  // heading to cant. The operator can change it mid-run from the
  // shoreside Action/Cant Angle menu, which posts EVICT_CANT.
  //
  // 0 = off, the geometry every measurement in this file was taken on.
  cant_deg      = 0

  // A station dead ahead of the intruder, or dead astern, sits ON the
  // centreline and has no inward side -- both directions turn the bow
  // equally far off the track. Within this many degrees of that line the
  // cant is dropped rather than letting noise flip the bow from one beam
  // to the other.
  cant_dead_deg = 5

  // Hysteresis on the station pairing. Without it the two USVs traded
  // stations at 2 Hz once they were near-symmetric about the target,
  // and both just spun in place.
  swap_margin_deg = 30

  // Within this of the region center the "outboard" direction is
  // meaningless, so the arc falls back to the target's stern.
  center_deadzone = 20

  repost_interval = 4
  draw_pincer     = true

  // Frame the station bearing is handed to BHV_Trail in.
  //
  // The arc is computed in absolute bearings either way. Ordered as an
  // absolute bearing, though, every degree the intruder turns has to
  // come back out as a fresh TRAIL_UPDATE -- quantised to 1 degree, at
  // this app's tick, one pShare hop late -- so the two station points
  // sat still and then jumped across the chart during a turn.
  // "relative" hands BHV_Trail the offset from the intruder's heading
  // instead and lets it add the heading term itself, every helm
  // iteration, off its own extrapolated contact record: the station
  // sweeps smoothly through the turn and only the slow part of the
  // geometry (which way we are herding) travels over the wire.
  station_frame   = relative

  //---------------------------------------------------------------
  // Automatic engagement cycle
  //
  // SEARCHING -> INTERCEPTING when the intruder is inside the search
  //   area and within detection range of either USV.
  // INTERCEPTING -> SEARCHING (a successful eviction) once it has been
  //   pushed clear of the area, or clear of every USV's detection
  //   range, and has stayed clear for release_hold seconds.
  //
  // The operator's INTERCEPT button starts the SAME engagement early
  // and it runs through the same release test. It used to set a flag
  // that switched the release test off entirely, which meant an
  // intercept started from the button never ended -- the pair kept
  // herding a target that had long since been driven out of the area.

  auto_engage = true

  // ONE range. detect_range=0 means "use SENSOR_RADIUS", and that same
  // number is what each USV's contact manager alerts at (the Sensor
  // Range menu retunes both together). It is only used here to draw the
  // ring on the chart: the engagement itself is contact-driven, off the
  // SUSPECT_REPORT transitions the USVs' own contact managers post.
  detect_range  = 0
  detect_scale  = 1.0
  sensor_radius = 45         // until the first SENSOR_RADIUS arrives


  // Release is contact-driven too: every USV losing the contact, or the
  // intruder being clear of the region, held for release_hold seconds.
  // There is no range comparison left in the test -- during the pincer
  // the USVs are deliberately close enough to keep holding the contact
  // right up until the intruder is outside the area, so the region-exit
  // half is what normally fires.

  // 15 m clear of the region boundary, held for 8 s. The hold is what
  // makes it a driven-off judgement rather than a reading of one noisy
  // instant -- a target weaving along the boundary under pressure
  // crosses out and back several times before it actually leaves.
  // The operator can change this mid-run from the shoreside
  // Action/Eviction Distance menu, which posts EVICT_BUFFER.
  region_exit_buffer = 15
  release_hold       = 8

  // Deaf period after a success, so the USVs get to turn back into
  // their search pattern instead of re-acquiring the same target while
  // it is still on their doorstep.
  reengage_delay = 10

  draw_detect_rings = true

  // false turns INTERCEPT back into a latch that only SURVEY releases.
  operator_release  = true

  //---------------------------------------------------------------
  // Leave the intruder a way out.
  //
  // The sea room Rule 8(f) asks for is already there by construction:
  // stations occupy only spread_deg (120) of arc centred on the inboard
  // bearing, so the whole outward half-plane -- the direction we want
  // the intruder to leave by -- is open water.
  //
  // This was an escape_lane_deg=70 rule that rotated the entire
  // blocking arc off a sector centred on the intruder's heading plus
  // 90. With spread_deg=120 that demanded 95 degrees of clearance, so
  // whenever the intruder tracked roughly tangentially the wall was
  // rotated by up to 95 degrees -- no longer between it and the water
  // it wanted. That is what inverted the herding direction and let the
  // intruder head back to the region centre unopposed.
  //
  // All that is left to guard is parking a USV bow-on in front of it,
  // and that is a small nudge, not a wholesale rotation.
  // 0 = OFF. The bow guard is one of the two places the pincer looks at
  // the intruder's heading; both are disabled for the heading-free
  // experiment. Restore to 20 to put it back.
  bow_guard_deg = 0

  //---------------------------------------------------------------
  // Which way to push it out.
  //
  // The blocking arc is anchored to the RECIPROCAL of a chosen exit
  // bearing, so the USVs sit on the side the intruder is being pushed
  // away from and the open water is the way out.
  //
  // The exit bearing is picked by scoring each of 36 bearings on
  //
  //     cost = (metres the intruder must still travel along that
  //             bearing to be region_exit_buffer clear of the area)
  //          + heading_bias * (degrees off the intruder's own head)
  //
  // heading_bias is the price, in metres of detour, the fleet will pay
  // to avoid asking the intruder for a turn. Distance alone always
  // picks the nearest way out, but on a 280x120 m region that usually
  // means demanding a full reversal; the intruder resists and the
  // engagement drags. The bias buys momentum back at a stated price.
  //
  // 0.35 is a DELIBERATELY CHEAP price: a 90-degree turn is worth 31 m
  // of detour, a full reversal 63 m -- about half the width of the
  // field. Measured over eight starting geometries on the default
  // region, this picks an exit averaging 3 m longer than the nearest
  // one available.
  //
  // It used to be 2.0, which is 180 m for a 90-degree turn on a field
  // only 120 m across -- so the geometry could never outvote the
  // heading, and an intruder sitting 10 m inside the NORTH edge but
  // pointing south was escorted 125 m across the whole region to be
  // pushed out the SOUTH edge, right past the pair, instead of the
  // 25 m out of the edge it was already touching. Same at 1.0. The
  // behaviour changes between 0.5 and 0.35: at 0.5 an intruder in the
  // southern half heading north is still walked 105 m to the north
  // edge; at 0.35 it is turned round and pushed out the 48 m way.
  //
  // Going all the way to 0 is worse, not better: it asks for a 152
  // degree turn on average, which is a head-on push in almost every
  // engagement.
  //
  // Note this only decides the exit the run STARTS on -- exit_commit
  // below then latches it.
  //
  // exit_margin is hysteresis: a new bearing has to beat the one we are
  // committed to by this much cost before the wall is re-anchored. A
  // wall that swings as the intruder yaws does not push.
  // 0 = OFF, and this is the OTHER place the pincer looks at the
  // intruder's heading. At zero the exit bearing is decided by the
  // geometry alone -- the shortest way out of the area from where it is
  // standing -- and the blocking arc, which is anchored to the
  // reciprocal of that, stops moving when the intruder turns. Restore to
  // 0.35 to put it back.
  heading_bias = 0
  exit_margin  = 15

  // ...and exit_commit is the rest of that hysteresis, in seconds.
  //
  // exit_margin alone was not enough. The distance term is "how far the
  // intruder still has to travel to be clear of the area by the
  // eviction distance", and near the boundary that number is small on
  // EVERY outward bearing -- so the cost there is almost pure heading,
  // and 15 m of margin is only 7.5 degrees of it at the default bias.
  // The intruder's own yaw covers that. Result: it reached the edge,
  // turned hard along it, dragged the exit bearing round with it, and
  // the arc -- anchored to the reciprocal -- swung off the water it had
  // just been pushed out of. It turned again and went back in.
  //
  // So the exit is LATCHED when the engagement starts and a rival
  // bearing has to hold its advantage for exit_commit seconds before it
  // takes over. That is something the intruder cannot fake by yawing:
  // it would have to actually hold the new course. Pick a lane, push it
  // out that lane.
  //
  // 0 restores the old behavior (re-anchor as soon as the margin is
  // cleared).
  exit_commit  = 5

  // The flanks are frozen the same way, and for the same reason: a
  // mid-run swap means both USVs leave station and cross the intruder's
  // track to change places, and for the seconds that takes there is no
  // wall at all. The pairing is taken once, when the engagement starts,
  // from the flank each USV is already on. swap_margin_deg still
  // applies to the pairing taken BEFORE the engagement.
  swap_lock    = true

  //---------------------------------------------------------------
  // Blocking stations (pincer_mode = block)
  //
  // THE MECHANISM. The intruder is driven off by its own collision
  // avoidance, and that behavior scores every candidate course and
  // speed by PROJECTED CPA: no utility below 12 m, full utility above
  // 25 m. Two things follow, and the old trail arc got both wrong.
  //
  // First, a station further than 25 m off the intruder's TRACK is
  // invisible to it -- not weak, invisible, because "perfect" is the
  // score every solution already gets.
  //
  // Second, and this is the one that mattered: a projected CPA needs
  // relative velocity to exist. BHV_Trail steers the USV at the
  // contact's own course and speed once it is on station, so the pair
  // moves as one, the CPA equals the present range for every manoeuvre
  // the intruder could make, and its avoidance function is FLAT. A flat
  // function contributes nothing to the helm's solution whatever weight
  // it carries. Swept over the intruder's whole manoeuvre space, the
  // best escape it could find beat holding course by 0.0 at every trail
  // range from 30 m down to 14 m. That is why the pair looked like it
  // was escorting the target around the field rather than evicting it.
  //
  // So the station is a GROUND-FIXED point, ahead of the intruder and
  // just off its track. It does not move with the intruder, so there is
  // relative velocity, so there is a CPA, so there is a gradient: at
  // 50 m lead and 18 m offset, carrying on scores 59.6 against 100 for
  // turning away.

  // How far ahead the blocker stands. Far enough that the intruder has
  // time to see the geometry and turn once (Rule 8b, a substantial
  // alteration rather than a succession of small late ones): 50 m at
  // its 0.8 m/s is about a minute. It is also what keeps the STRAIGHT
  // LINE range to the intruder near 53 m -- far outside the 22 m band
  // where our own avoidance of it would start fighting the station.
  block_lead   = 50

  // The lateral offset from the intruder's track. THIS IS THE SAFETY
  // DISTANCE: it is what the intruder passes at if it ignores us
  // completely. This is now a CEILING, not the number stood at -- see
  // block_reaction_* below. 18 m happens to be a good starting guess
  // for a target with this simulator's avoidance config, but nothing
  // here should assume that config is known. Floored at
  // block_min_offset. If the intruder presses on anyway, avdtgt_ (pwt
  // 300) outranks the station-keeping behavior (pwt 200) and the USV
  // gives way -- the block is a position, not a refusal to keep clear.
  block_offset = 18

  // ADAPTIVE OFFSET. block_offset above is only where a fresh
  // engagement STARTS. A hard-coded number that happens to sit inside
  // this simulated target's reaction band tells us nothing about a
  // contact of unknown type -- different avoidance model, a human on
  // the helm, or none at all -- so instead of assuming the band, the
  // coordinator finds it: hold the current offset for
  // block_reaction_wait seconds and watch the intruder's own heading.
  // If it turns away from the block side by block_reaction_deg or more,
  // the offset is working and is frozen for the rest of the engagement.
  // If nothing happens in that window, shave block_shrink_step off it
  // and try again, no lower than block_min_offset. See
  // updateAdaptiveOffset() in TargetCoordinator.cpp.
  block_reaction_wait = 6
  block_reaction_deg  = 8
  block_shrink_step   = 3

  // Hard floor. 14 m is avdtgt_'s min_util_cpa_dist, the CPA our own
  // avoidance behavior calls the floor of a safe pass, and 2 m above the
  // 12 m the intruder's own behavior treats as a collision. A smaller
  // number here would be staging one.
  block_min_offset = 14

  // The second USV stands this much further out on the same side, and
  // at block_lead2 of the lead. It does not threaten the present track
  // -- 52 m off it is beyond the intruder's reaction distance, by
  // design -- and is not meant to. Its job is to be already there if
  // the intruder tries to turn back the way we do not want it to go.
  block_span   = 34
  block_lead2  = 0.6

  // When the intruder is already heading within this of the exit
  // bearing there is nothing to correct, and blocking the bow of a
  // vessel that is leaving would only turn it back in. The pair splits
  // into a funnel instead: one either side, both wide enough to leave
  // the lane ahead open.
  block_dead_deg = 15

  // How long a side flip has to be wanted, continuously, before it is
  // taken -- the same latch idea as the exit bearing above, applied to
  // WHICH SIDE the pair blocks from. Without this, a target weaving (or
  // just yawing under its own COLREGs avoidance) across the exit
  // bearing flips block_side every time it crosses, and each flip threw
  // away whatever the formation had built up on the old side: the run
  // looked like repeated failed attempts from alternating directions
  // instead of one sustained push.
  block_side_commit = 4

  // RE-ISSUING THE POINT. A station recomputed every iteration would
  // translate with the intruder, the USV would chase it at the
  // intruder's own speed, and the relative velocity -- the whole source
  // of the pressure -- would be zero again. So a point is held until it
  // is spent, and only then is a new one dropped in front of where the
  // intruder is going now:
  //
  //   block_slack     the point stops biting once the intruder's turn
  //                   has carried its track this far from it. Just
  //                   under the 25 m at which the intruder stops
  //                   reacting, so the replacement is issued at the
  //                   moment the old one goes quiet, not before.
  //   block_min_lead  and it is spent once the intruder is level with
  //                   it: a station abeam or astern blocks nothing.
  //   block_interval  floor on how often a new one may be issued, so a
  //                   yawing intruder cannot make us drag the station
  //                   along behind it.
  block_slack    = 22
  block_min_lead = 25
  block_interval = 5

  // TRANSIT FEASIBILITY -- the one that actually decides whether an
  // eviction succeeds or keeps restarting from another direction.
  //
  // Measured over two untouched 900 s benchmark runs (bench.sh/bench.py,
  // giveway excluded, genuine re-anchors only):
  //
  //     station lifetime      median  7 - 14 s
  //     transit time NEEDED   median 23 - 39 s
  //     stations ever reached        30 - 37 %
  //     median closest approach      17 - 35 m
  //
  // The fleet was being ordered to points it could not physically
  // occupy. Every time the intruder yawed enough to move its track, the
  // order was torn up and replaced -- throwing away the ten or fifteen
  // seconds of transit already spent and starting a fresh thirty-second
  // journey somewhere else. The re-anchor cadence was set by how fast
  // the INTRUDER manoeuvres; it has to be set by how fast OUR OWN
  // vehicles move, because that is what bounds how often the fleet can
  // usefully change its mind.
  //
  //   block_commit_transit  hold an off-track point while the USV
  //                         assigned to it is still closing and inside
  //                         its transit estimate. A point the intruder
  //                         has already drawn level with is retired
  //                         regardless -- that one is beyond rescue.
  //   block_transit_frac    multiplier on the straight-line estimate.
  //   block_transit_cap     absolute ceiling, so an unreachable point
  //                         cannot be held forever.
  //   block_feasible        walk the lead down from block_lead until
  //                         the blocker can reach the station before
  //                         the intruder draws level with it.
  //   block_usv_speed       fallback when a node report carries none.
  block_commit_transit = true
  block_transit_frac   = 1.0
  block_transit_cap    = 40
  block_feasible       = true
  block_usv_speed      = 2.0

  // STATION STABILITY -- the three settings that answer "the point
  // jumps" and "it moves again before the USV ever gets there".
  //
  // block_course_tau   The station is projected block_lead metres along
  //   the intruder's course, so one degree of yaw slides it about 0.9 m
  //   sideways and the 10-15 degree swings a target makes while it is
  //   being pushed slide it 9-13 m -- most of the offset the scheme is
  //   trying to impose. Worse, blockOffTrack() judges the STANDING
  //   point against that same jittering line, so a yaw both moves the
  //   next point and condemns the current one. A first-order lag of
  //   this many seconds passes a real alteration (which takes tens of
  //   seconds) almost undamped and averages the yaw away. 0 = raw
  //   heading, the old behaviour.
  //
  // block_lead_margin  Clearance between the lead a point is issued at
  //   and block_min_lead, the along-track distance at which it is
  //   declared spent. These used to be the same number: when nothing
  //   was reachable, feasibleLead() returned block_min_lead and the
  //   point was spent the instant it was born -- retired next pass,
  //   re-issued block_interval later at the same dead distance, for as
  //   long as the geometry stayed hard. It also buys the blocker this
  //   many metres worth of seconds to be ON station before the intruder
  //   draws level, rather than arriving exactly as it passes.
  //
  // block_lead_hyst    feasibleLead() is a function of where the
  //   blocker IS, so its answer improves continuously as the USV closes
  //   -- 25 m when it sets off, 45 m half a minute later. Two re-issues
  //   from otherwise identical geometry then land the point 20 m apart
  //   for reasons having nothing to do with the intruder. The lead is
  //   held until the feasible answer moves by this much.
  block_course_tau   = 6
  block_lead_margin  = 10
  block_lead_hyst    = 12

  // GIVING WAY. block_offset is the distance the intruder passes at
  // while it keeps to the track we measured it on. An intruder that
  // turns INTO the station instead closes on a vehicle that is, by
  // design, sitting still, and the two behaviors sharing that vehicle's
  // helm -- station keeping at pwt 200, avdtgt_ at 300 -- split the
  // solution between them rather than one winning outright. Measured
  // before this rule existed: 8.1 m at the worst and 29 seconds of a
  // 20-minute run inside 14 m.
  //
  // So the coordinator gives way itself, at a range it picks, instead
  // of leaving it to that contest. Inside block_abort the station is
  // replaced by a point directly away from the intruder and the USV
  // turns out; blocking resumes past block_abort + block_rearm with a
  // fresh point in front of wherever the intruder is going by then.
  //
  // 18 m is the same number as block_offset: we never come closer than
  // the distance the block was promising in the first place.
  // 25 rather than 18, because giving way is not instant: the USV can
  // be transiting toward its station at 3 m/s while the intruder closes
  // at 0.8, and at 18 m it overshot to 10.8 m before the turn took
  // effect. Starting the turn at 25 m absorbs that. It costs nothing:
  // the block does its work through the intruder's PROJECTED CPA, from
  // 50 m ahead, long before the two are 25 m apart -- if it has not
  // turned by then the block has already failed and yielding is the
  // right answer anyway.
  block_abort = 25
  block_rearm = 10
}

