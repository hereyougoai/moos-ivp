//--------------------------------------------------------
// Mothership Config file
// Acts as the fleet coordinator for m_shield_demo
// Communicates with vehicles via shoreside's pShare bridge
//
// Port layout:
//   MOOSDB    : $(MOOS_PORT)  [default 9005]
//   pShare in : $(PSHARE_PORT) [default 9205]
//   pShare out: $(SHORE_PSHARE) [default 9200, shoreside]

ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = mothership

#include plugs.moos <origin_warp>
  
//--------------------------------------------------------
Processconfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB          @ NewConsole = false
  Run = pRealm          @ NewConsole = false
  Run = pLogger         @ NewConsole = false
  Run = uProcessWatch   @ NewConsole = false
  Run = pShare          @ NewConsole = false
  Run = pHostInfo       @ NewConsole = false

  // Coordinator apps
  Run = pRegionDivider     @ NewConsole = false
  Run = pTargetCoordinator @ NewConsole = false
}

#include plugs.moos <pHostInfo>
#include plugs.moos <uProcessWatch>

//--------------------------------------------------
// pShare Config Block
//
// Coordinator commands go STRAIGHT DOWN to the sub-vessels.
// They must not be relayed via the shoreside: pShare refuses to inject
// an inbound variable into its local DB when it also holds an outbound
// route of the same name, and uFldShoreBroker creates exactly such a
// route for every qbridged variable (WPT_UPDATE_ABE -> WPT_UPDATE).

ProcessConfig = pShare
{
  AppTick    = 2
  CommsTick  = 2

  // Inbound: NODE_REPORTs from every vessel, MISSION_POLY + DEPLOY_ALL
  // from the shoreside.
  input = route = localhost:$(PSHARE_PORT)

  // Outbound: per-vehicle tasking, delivered on the vehicle's own name.
  output = src_name=WPT_UPDATE_ABE,     dest_name=WPT_UPDATE,     route=localhost:$(USV1_PSHARE=9201)
  output = src_name=WPT_UPDATE_BEN,     dest_name=WPT_UPDATE,     route=localhost:$(USV2_PSHARE=9202)
  output = src_name=TRAIL_UPDATE_ABE,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV1_PSHARE=9201)
  output = src_name=TRAIL_UPDATE_BEN,   dest_name=TRAIL_UPDATE,   route=localhost:$(USV2_PSHARE=9202)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV1_PSHARE=9201)
  output = src_name=SUSPECT_TARGET_ALL, dest_name=SUSPECT_TARGET, route=localhost:$(USV2_PSHARE=9202)

  // Automatic engagement: pTargetCoordinator raises the alert when an
  // intruder is detected and drops it again once the intruder has been
  // driven off. These deliberately carry their own names rather than
  // reusing TARGET_ALERT_ALL / SURVEY_ALL: those arrive here from the
  // shoreside, and pShare refuses to inject an inbound variable into
  // the local DB once an outbound route of the same name exists, so
  // publishing them under the same name would silently kill the
  // operator's own INTERCEPT and SURVEY buttons. They land on the
  // vehicles as the same TARGET_ALERT / SURVEY the operator drives.
  output = src_name=TARGET_ALERT_AUTO, dest_name=TARGET_ALERT, route=localhost:$(USV1_PSHARE=9201)
  output = src_name=TARGET_ALERT_AUTO, dest_name=TARGET_ALERT, route=localhost:$(USV2_PSHARE=9202)
  output = src_name=SURVEY_AUTO,       dest_name=SURVEY,       route=localhost:$(USV1_PSHARE=9201)
  output = src_name=SURVEY_AUTO,       dest_name=SURVEY,       route=localhost:$(USV2_PSHARE=9202)

  // Coordinator's own visuals (mission region outline + the swept
  // coverage grid) go up to the shoreside so the operator sees them.
  output = src_name=VIEW_POLYGON,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID,       route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_GRID_DELTA, route=localhost:$(SHORE_PSHARE)
  // The pincer arms, detection rings and station markers drawn by
  // pTargetCoordinator.
  output = src_name=VIEW_SEGLIST,    route=localhost:$(SHORE_PSHARE)
  output = src_name=VIEW_POINT,      route=localhost:$(SHORE_PSHARE)

  // Engagement-cycle readout, so the operator can see detections and
  // successful evictions on the shoreside scope.
  output = src_name=SHIELD_STATE,      route=localhost:$(SHORE_PSHARE)
  output = src_name=SHIELD_DETECTIONS, route=localhost:$(SHORE_PSHARE)
  output = src_name=SHIELD_EVICTIONS,  route=localhost:$(SHORE_PSHARE)
}

ProcessConfig = pLogger
{
  AppTick       = 10
  CommsTick     = 10
  File          = XLOG_MOTHERSHIP
  PATH          = ./
  SyncLog       = true @ 0.2
  AsyncLog      = true
  FileTimeStamp = true
  LogAuxSrc     = true
  WildCardLogging = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//--------------------------------------------------
// pRegionDivider Config Block
//
// Plans the fleet's sweep of the operator's MISSION_POLY (or, absent
// that, a default region) and posts each vehicle a WPT_UPDATE_<VNAME>
// point list.
//
// Three things about the plan are worth knowing:
//
//  1. The lanes run along the region's own long axis, found from the
//     minimum-area bounding rectangle, not along a fixed east-west
//     compass line. A region drawn on a diagonal used to be swept in
//     many short east-west lanes with a hard 180 at the end of each;
//     now the lanes follow the region and there are far fewer turns.
//
//  2. The region is cut into one band per vehicle ACROSS that lane
//     axis. Cutting the other way (the old west->east strips) halves
//     the length of every lane and so doubles the number of turns for
//     exactly the same water covered.
//
//  3. Lane spacing is not a fixed number; it comes from sensor_radius.
//     A sensor seeing 15 m in every direction covers a 30 m swath, so
//     lanes sit 27 m apart (10% seam) rather than the old fixed 20 m,
//     and the lane ends stop 0.7*15 m short of the boundary because
//     the sensor already sees that far ahead. Both cut distance driven
//     without leaving water unsearched.

ProcessConfig = pRegionDivider
{
  AppTick   = 2
  CommsTick = 2

  vnames = $(VNAMES)

  // Operator-selectable at run time via SEARCH_PATTERN
  // (lawnmower | skip | spiral | perimeter) -- see the PAT:* buttons.
  pattern     = lawnmower

  // "auto" takes the sweep direction from the region shape. Force it
  // with east-west / north-south if a fixed heading is wanted.
  sweep_align = auto

  // Sensor / visual range, in metres. Drives the lane spacing, the
  // lane-end trimming, and the coverage shading. Adjustable at run
  // time via SENSOR_RADIUS (the SEE:* buttons).
  sensor_radius   = 45
  auto_lane_width = true
  lane_overlap    = 0.10
  endpoint_inset  = 0.70

  cell_size = 10

  // Falls back to this if DEPLOY_ALL fires before the operator has
  // ever pressed REGION to send a MISSION_POLY up from the shoreside.
  default_region = pts={-70,-10:210,-10:210,-130:-70,-130}
}

//--------------------------------------------------
// pTargetCoordinator Config Block
// While TARGET_ALERT_ALL is true, puts the vehicles in $(VNAMES) on a
// blocking arc between the target and the middle of the search region
// (REGION_CENTER, published by pRegionDivider) and posts each an
// absolute-bearing TRAIL_UPDATE_<VNAME>. The pair therefore stands
// between the intruder and the water it wants, and its own collision
// avoidance drives it outward -- a pincer, not a tail chase.

ProcessConfig = pTargetCoordinator
{
  AppTick   = 2
  CommsTick = 2

  vnames      = $(VNAMES)
  target_name = target

  pincer_mode = herd   // or "stern" for the old astern-fan behavior

  // 120 deg apart on the inboard arc: the two USVs sit roughly on the
  // target's beams rather than in a queue behind it, which is what
  // makes the envelopment visible and gives its avoidance behavior
  // pressure from both sides at once.
  spread_deg  = 120

  // The station has to satisfy two things at once: close enough to be
  // inside the intruder's own avoidance band (pwt_outer_dist 55) so the
  // pressure is continuous rather than a single dodge, and far enough
  // out that it is NOT inside the USV's own COLREGs avoidance of the
  // intruder (pwt_outer_dist 30) -- otherwise the two behaviors fight
  // and the pass ends up closer than either asked for.
  //
  // 30 m sits in the window (22 < 30 < 55) and, crucially, at or inside
  // the intruder's pwt_inner_dist of 25-ish where its avoidance is at
  // full relevance rather than ramping. At 40 m the wall was sitting in
  // the ramp between the intruder's inner (25) and outer (55)
  // distances, so it pushed at partial strength: the intruder could
  // orbit the region centre for several laps before the pressure
  // accumulated enough to squeeze it out.
  trail_range = 30

  // Hard floor, so a later edit to trail_range cannot quietly put the
  // fleet back inside the avoidance band. Rule 8(d): action taken to
  // avoid collision must "result in passing at a safe distance".
  min_standoff = 25

  // Hysteresis on the station pairing. Without it the two USVs traded
  // stations at 2 Hz once they were near-symmetric about the target,
  // and both just spun in place.
  swap_margin_deg = 30

  // Within this of the region center the "outboard" direction is
  // meaningless, so the arc falls back to the target's stern.
  center_deadzone = 20

  repost_interval = 4
  draw_pincer     = true

  //---------------------------------------------------------------
  // Automatic engagement cycle
  //
  // SEARCHING -> INTERCEPTING when the intruder is inside the search
  //   area and within detection range of either USV.
  // INTERCEPTING -> SEARCHING (a successful eviction) once it has been
  //   pushed clear of the area, or clear of every USV's detection
  //   range, and has stayed clear for release_hold seconds.
  //
  // The operator's INTERCEPT button starts the SAME engagement early
  // and it runs through the same release test. It used to set a flag
  // that switched the release test off entirely, which meant an
  // intercept started from the button never ended -- the pair kept
  // herding a target that had long since been driven out of the area.

  auto_engage = true

  // ONE range. detect_range=0 means "use SENSOR_RADIUS", and that same
  // number is what each USV's contact manager alerts at (the Sensor
  // Range menu retunes both together). It is only used here to draw the
  // ring on the chart: the engagement itself is contact-driven, off the
  // SUSPECT_REPORT transitions the USVs' own contact managers post.
  detect_range  = 0
  detect_scale  = 1.0
  sensor_radius = 45         // until the first SENSOR_RADIUS arrives


  // Release is contact-driven too: every USV losing the contact, or the
  // intruder being clear of the region, held for release_hold seconds.
  // There is no range comparison left in the test -- during the pincer
  // the USVs are deliberately close enough to keep holding the contact
  // right up until the intruder is outside the area, so the region-exit
  // half is what normally fires.

  // 15 m clear of the region boundary, held for 8 s. The hold is what
  // makes it a driven-off judgement rather than a reading of one noisy
  // instant -- a target weaving along the boundary under pressure
  // crosses out and back several times before it actually leaves.
  region_exit_buffer = 15
  release_hold       = 8

  // Deaf period after a success, so the USVs get to turn back into
  // their search pattern instead of re-acquiring the same target while
  // it is still on their doorstep.
  reengage_delay = 10

  draw_detect_rings = true

  // false turns INTERCEPT back into a latch that only SURVEY releases.
  operator_release  = true

  //---------------------------------------------------------------
  // COLREGs: leave the intruder a compliant way out.
  //
  // The sea room Rule 8(f) asks for is already there by construction:
  // stations occupy only spread_deg (120) of arc centred on the inboard
  // bearing, so the whole outward half-plane -- the direction we want
  // the intruder to leave by -- is open water.
  //
  // This was an escape_lane_deg=70 rule that rotated the entire
  // blocking arc off a sector centred on the intruder's heading plus
  // 90. With spread_deg=120 that demanded 95 degrees of clearance, so
  // whenever the intruder tracked roughly tangentially the wall was
  // rotated by up to 95 degrees -- no longer between it and the water
  // it wanted. That is what inverted the herding direction and let the
  // intruder head back to the region centre unopposed.
  //
  // All that is left to guard is parking a USV bow-on in front of it,
  // and that is a small nudge, not a wholesale rotation.
  bow_guard_deg = 20

  //---------------------------------------------------------------
  // Which way to push it out.
  //
  // The blocking arc is anchored to the RECIPROCAL of a chosen exit
  // bearing, so the USVs sit on the side the intruder is being pushed
  // away from and the open water is the way out.
  //
  // The exit bearing is picked by casting a ray from the intruder to
  // the region boundary on each of 36 bearings and scoring
  //
  //     cost = (distance to the boundary along that bearing)
  //          + heading_bias * (degrees off the intruder's own head)
  //
  // Distance alone picks the nearest way out, which on a 280x120 m
  // region often means demanding the intruder reverse course -- it
  // resists, and the engagement turns into laps of the centre. At
  // 2 m/deg a 90-degree turn is charged 180 m, so an exit aligned with
  // where it is already going wins unless it is very much longer. The
  // fleet works with the intruder's momentum instead of against it.
  //
  // exit_margin is hysteresis: a new bearing has to beat the one we are
  // committed to by this much cost before the wall is re-anchored. A
  // wall that swings as the intruder yaws does not push.
  heading_bias = 2.0
  exit_margin  = 15
}

